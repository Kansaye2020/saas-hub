  "description": "Serveur unificateur et passerelle de paiement multi-SaaS auto-hébergé (LomoPay, Whop, Stripe, Chariow)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
