<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paiement Confirmé | <%= storeName || 'Boutique' %></title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-base-200 min-h-screen flex items-center justify-center p-4">
    <div class="card w-full max-w-md bg-base-100 shadow-xl border border-base-300 text-center p-6 sm:p-8 rounded-3xl">
        
        <div class="w-16 h-16 rounded-full bg-success/15 text-success mx-auto flex items-center justify-center mb-4 text-3xl font-black animate-bounce">
            ✓
        </div>
        
        <h1 class="text-2xl font-black text-base-content mb-1">Paiement Validé !</h1>
        <p class="text-sm text-base-content/60 mb-6">Votre transaction a été confirmée avec succès.</p>
        
        <% if (session && session.orderId) { %>
            <div class="bg-base-200 rounded-xl p-3.5 mb-6 text-xs text-base-content/80 font-mono">
                Commande : <strong>#<%= session.orderId %></strong>
            </div>
        <% } %>

        <div id="popup-notice" class="hidden">
            <p class="text-xs text-base-content/50 mb-3">Cette fenêtre va se fermer automatiquement...</p>
            <button onclick="window.close()" class="btn btn-primary btn-sm btn-block rounded-xl">Fermer la fenêtre</button>
        </div>

        <div id="redirect-notice">
            <p class="text-xs text-base-content/50 mb-3">Redirection vers votre espace...</p>
            <a id="return-link" href="<%= returnUrl %>" class="btn btn-primary btn-block rounded-xl">
                Continuer
            </a>
        </div>
    </div>

    <script>
        const returnUrl = "<%= returnUrl %>";
        const orderId = "<%= session ? session.orderId : '' %>";
        const token = "<%= token %>";

        // Détection mode Pop-up vs Redirection directe
        if (window.opener && window.opener !== window) {
            document.getElementById('popup-notice').classList.remove('hidden');
            document.getElementById('redirect-notice').classList.add('hidden');

            try {
                // Notifier le site parent (SaaS)
                window.opener.postMessage({
                    type: 'HUB_PAYMENT_SUCCESS',
                    status: 'success',
                    orderId: orderId,
                    token: token
                }, '*');
            } catch (e) {
                console.error("Erreur postMessage:", e);
            }

            // Fermeture automatique de la popup
            setTimeout(() => {
                window.close();
            }, 1800);
        } else {
            // Mode Redirection directe
            if (returnUrl && returnUrl.startsWith('http')) {
                setTimeout(() => {
                    window.location.href = returnUrl;
                }, 1200);
            }
        }
    </script>
</body>
</html>
