<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paiement Annulé | <%= storeName || 'Boutique' %></title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-base-200 min-h-screen flex items-center justify-center p-4">
    <div class="card w-full max-w-md bg-base-100 shadow-xl border border-base-300 text-center p-6 sm:p-8 rounded-3xl">
        
        <% if (locals.storeLogo && storeLogo.trim()) { %>
            <div class="mb-3 flex justify-center">
                <img src="<%= storeLogo %>" alt="<%= storeName %>" class="w-14 h-14 rounded-2xl object-contain bg-base-100 shadow-md p-1 border border-base-300 max-h-14" onerror="this.style.display='none'" />
            </div>
        <% } %>

        <div class="w-16 h-16 rounded-full bg-base-300 text-base-content/70 mx-auto flex items-center justify-center mb-4 text-2xl font-black">
            ✕
        </div>
        
        <h1 class="text-2xl font-black text-base-content mb-1">Paiement Annulé</h1>
        <p class="text-xs font-semibold text-primary mb-1"><%= storeName || 'Boutique' %></p>
        <p class="text-sm text-base-content/60 mb-6">La transaction n'a pas abouti ou a été interrompue.</p>
        
        <% if (session && session.orderId) { %>
            <div class="bg-base-200 rounded-xl p-3.5 mb-6 text-xs text-base-content/80 font-mono">
                Commande : <strong>#<%= session.orderId %></strong>
            </div>
        <% } %>

        <div id="popup-notice" class="hidden">
            <p class="text-xs text-base-content/50 mb-3">Fermeture automatique de la fenêtre...</p>
            <button onclick="closeParentOrWindow()" class="btn btn-ghost btn-sm btn-block rounded-xl border border-base-300">Fermer</button>
        </div>

        <div id="redirect-notice">
            <p class="text-xs text-base-content/50 mb-3">Retour à votre espace...</p>
            <a id="return-link" href="<%= cancelUrl %>" class="btn btn-primary btn-block rounded-xl">
                Retourner à la boutique
            </a>
        </div>
    </div>

    <script>
        const cancelUrl = "<%= cancelUrl %>";
        const orderId = "<%= session ? session.orderId : '' %>";
        const token = "<%= token %>";

        const paymentCancelPayload = {
            type: 'HUB_PAYMENT_CANCEL',
            status: 'cancelled',
            orderId: orderId,
            token: token
        };

        function closeParentOrWindow() {
            if (window.opener && window.opener !== window) {
                window.close();
            } else if (window.parent && window.parent !== window) {
                window.parent.postMessage({ type: 'HUB_PAYMENT_CLOSE' }, '*');
                window.parent.postMessage('ikeepay-close', '*');
            }
        }

        // 1. Détection Iframe (Modale / Popup Widget intégrée dans la page)
        if (window.parent && window.parent !== window) {
            document.getElementById('popup-notice').classList.remove('hidden');
            document.getElementById('redirect-notice').classList.add('hidden');

            try {
                window.parent.postMessage(paymentCancelPayload, '*');
                window.parent.postMessage({ type: 'HUB_PAYMENT_CLOSE' }, '*');
                window.parent.postMessage('ikeepay-close', '*');
                window.parent.postMessage('payment_cancel', '*');
                window.parent.postMessage('whop:payment:cancel', '*');
            } catch (e) {
                console.error("Erreur postMessage parent:", e);
            }

            // Si le parent ne gère pas le postMessage, on redirige la fenêtre principale
            if (cancelUrl && cancelUrl.startsWith('http') && !cancelUrl.includes('mode=widget')) {
                setTimeout(() => {
                    try {
                        window.top.location.href = cancelUrl;
                    } catch (e) {}
                }, 1000);
            }
        }
        // 2. Détection Popup Fenêtre indépendante
        else if (window.opener && window.opener !== window) {
            document.getElementById('popup-notice').classList.remove('hidden');
            document.getElementById('redirect-notice').classList.add('hidden');

            try {
                window.opener.postMessage(paymentCancelPayload, '*');
                window.opener.postMessage('payment_cancel', '*');
            } catch (e) {
                console.error("Erreur postMessage opener:", e);
            }

            setTimeout(() => {
                window.close();
            }, 1200);
        }
        // 3. Mode Redirection directe (si pas dans une iframe ni popup)
        else if (window.self === window.top) {
            if (cancelUrl && cancelUrl.startsWith('http')) {
                setTimeout(() => {
                    window.location.href = cancelUrl;
                }, 1200);
            }
        }
    </script>
</body>
</html>
