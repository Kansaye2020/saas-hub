<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | SaaS Payment Hub</title>
    
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root, [data-theme="light"] {
            color-scheme: light;
            --color-base-100: oklch(100% 0 0);
            --color-base-200: oklch(98% 0 0);
            --color-base-300: oklch(95% 0 0);
            --color-base-content: oklch(21% 0.006 285.885);
            --color-primary: oklch(45% 0.24 277.023);
            --color-primary-content: oklch(93% 0.034 272.788);
            --color-secondary: oklch(65% 0.241 354.308);
            --color-secondary-content: oklch(94% 0.028 342.258);
            --color-accent: oklch(77% 0.152 181.912);
            --color-accent-content: oklch(38% 0.063 188.416);
            --color-neutral: oklch(14% 0.005 285.823);
            --color-neutral-content: oklch(92% 0.004 286.32);
            --color-info: oklch(74% 0.16 232.661);
            --color-info-content: oklch(29% 0.066 243.157);
            --color-success: oklch(76% 0.177 163.223);
            --color-success-content: oklch(37% 0.077 168.94);
            --color-warning: oklch(82% 0.189 84.429);
            --color-warning-content: oklch(41% 0.112 45.904);
            --color-error: oklch(71% 0.194 13.428);
            --color-error-content: oklch(27% 0.105 12.094);
            --radius-selector: 0.5rem;
            --radius-field: 0.25rem;
            --radius-box: 0.5rem;
            --size-selector: 0.25rem;
            --size-field: 0.25rem;
            --border: 1px;
            --depth: 1;
            --noise: 0;

            /* DaisyUI 4 properties */
            --p: 45% 0.24 277.023;
            --pc: 93% 0.034 272.788;
            --s: 65% 0.241 354.308;
            --sc: 94% 0.028 342.258;
            --a: 77% 0.152 181.912;
            --ac: 38% 0.063 188.416;
            --n: 14% 0.005 285.823;
            --nc: 92% 0.004 286.32;
            --b1: 100% 0 0;
            --b2: 98% 0 0;
            --b3: 95% 0 0;
            --bc: 21% 0.006 285.885;
            --in: 74% 0.16 232.661;
            --inc: 29% 0.066 243.157;
            --su: 76% 0.177 163.223;
            --suc: 37% 0.077 168.94;
            --wa: 82% 0.189 84.429;
            --wac: 41% 0.112 45.904;
            --er: 71% 0.194 13.428;
            --erc: 27% 0.105 12.094;
            --rounded-box: 0.5rem;
            --rounded-btn: 0.25rem;
            --rounded-badge: 0.5rem;
            --tab-radius: 0.5rem;
        }
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="<%= mode === 'widget' ? 'bg-transparent' : 'bg-base-200' %> flex items-center justify-center min-h-screen p-4 sm:p-6">
    
    <div class="card w-full max-w-md <%= mode === 'widget' ? 'bg-base-100' : 'bg-base-100 shadow-xl' %> border border-base-300">
        <div class="card-body p-6 sm:p-8">
            
            <div class="text-center mb-6">
                <div class="avatar placeholder mb-3">
                    <div class="bg-primary text-primary-content rounded-full w-14 shadow-sm">
                        <span class="text-xl font-bold"><%= storeName.charAt(0).toUpperCase() %></span>
                    </div>
                </div>
                <h2 class="text-2xl font-bold text-base-content"><%= storeName %></h2>
                <p class="text-sm text-base-content/60 mt-1">Paiement sécurisé</p>
            </div>

            <div class="bg-base-200 rounded-box p-6 text-center mb-8 border border-base-300">
                <p class="text-[10px] font-bold uppercase tracking-wider text-base-content/60 mb-2">Total à payer</p>
                <div class="text-4xl font-black text-base-content tracking-tight">
                    <%= session.amount.toLocaleString() %> <span class="text-xl opacity-60"><%= session.currency %></span>
                </div>
                <% if (session.description) { %>
                    <div class="badge badge-outline mt-3 font-semibold text-base-content/80"><%= session.description %></div>
                <% } %>
            </div>

            <form id="payment-form" action="/checkout/pay" method="POST">
                <input type="hidden" name="token" value="<%= session.token %>">
                
                <div class="form-control mb-8">
                    <label class="label pb-3">
                        <span class="label-text font-bold uppercase tracking-wider text-xs text-base-content/70">Moyen de paiement</span>
                    </label>
                    <div class="flex flex-col gap-3">
                        <% providers.forEach(function(provider, index) { %>
                            <label class="flex items-center gap-4 p-4 border border-base-300 rounded-xl cursor-pointer hover:border-primary/50 hover:bg-base-200/50 transition-colors bg-base-100">
                                <input type="radio" name="provider" value="<%= provider.id %>" class="radio radio-primary radio-sm" <%= index === 0 ? 'checked' : '' %> required />
                                
                                <div class="flex-1">
                                    <% if (provider.id === 'lomopay' || provider.id === 'chariow' || provider.id === 'ikeepay') { %>
                                        <div class="font-bold text-base-content text-sm sm:text-base">Mobile Money</div>
                                        <div class="text-xs text-base-content/60 mt-0.5">Momo, Wave, Orange</div>
                                    <% } else if (provider.id === 'stripe' || provider.id === 'whop') { %>
                                        <div class="font-bold text-base-content text-sm sm:text-base">Carte Bancaire</div>
                                        <div class="text-xs text-base-content/60 mt-0.5">Visa, Mastercard</div>
                                    <% } else { %>
                                        <div class="font-bold text-base-content text-sm sm:text-base"><%= provider.name %></div>
                                    <% } %>
                                </div>
                            </label>
                        <% }); %>
                    </div>
                </div>

                <div class="flex flex-col gap-3">
                    <button type="submit" id="submit-btn" class="btn btn-primary btn-block shadow-sm font-bold text-base">
                        Payer <%= session.amount.toLocaleString() %> <%= session.currency %>
                    </button>
                    
                    <% if (session.cancelUrl) { %>
                        <a href="<%= session.cancelUrl %>" class="btn btn-ghost btn-sm btn-block font-medium">Annuler et retourner</a>
                    <% } %>
                </div>
            </form>

        </div>
    </div>

    <script>
        const form = document.getElementById('payment-form');
        const submitBtn = document.getElementById('submit-btn');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const providerInput = document.querySelector('input[name="provider"]:checked');
            if (!providerInput) return;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="loading loading-spinner"></span> Traitement en cours...';

            try {
                const response = await fetch('/checkout/pay', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        token: document.querySelector('input[name="token"]').value,
                        provider: providerInput.value
                    })
                });

                const data = await response.json();

                if (data.checkoutUrl) {
                    if (window.self !== window.top) {
                        window.top.location.href = data.checkoutUrl;
                    } else {
                        window.location.href = data.checkoutUrl;
                    }
                } else {
                    alert(data.error || 'Erreur lors du paiement');
                    submitBtn.disabled = false;
                    submitBtn.innerText = 'Réessayer';
                }
            } catch (err) {
                alert('Erreur réseau.');
                submitBtn.disabled = false;
                submitBtn.innerText = 'Réessayer';
            }
        });
    </script>
</body>
</html>
