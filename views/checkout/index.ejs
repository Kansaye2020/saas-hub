<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Paiement Sécurisé | <%= storeName || 'Boutique' %></title>
    
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root, [data-theme="light"] {
            color-scheme: light;
            --color-base-100: oklch(100% 0 0);
            --color-base-200: oklch(98% 0 0);
            --color-base-300: oklch(95% 0 0);
            --color-base-content: oklch(21% 0.006 285.885);
            --color-primary: oklch(45% 0.24 277.023);
            --color-primary-content: oklch(93% 0.034 272.788);
            --p: 45% 0.24 277.023;
            --pc: 93% 0.034 272.788;
            --b1: 100% 0 0;
            --b2: 98% 0 0;
            --b3: 95% 0 0;
            --bc: 21% 0.006 285.885;
            --rounded-box: 1rem;
            --rounded-btn: 0.75rem;
        }
        body { font-family: 'Inter', sans-serif; }
        input, button, label { -webkit-tap-highlight-color: transparent; }

        /* SaaS Payment Hub Animated Logo Styles */
        .hub-anim-logo-container {
            position: relative;
            width: 88px;
            height: 88px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px auto;
        }
        .hub-ripple-ring {
            position: absolute;
            inset: -8px;
            border-radius: 32px;
            border: 2px solid rgba(99, 102, 241, 0.35);
            animation: hub-ripple 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
            pointer-events: none;
        }
        .hub-ripple-ring.ring-2 {
            animation-delay: 0.8s;
        }
        .hub-orbit-spinner {
            position: absolute;
            inset: -4px;
            border-radius: 26px;
            padding: 2px;
            background: linear-gradient(135deg, #4f46e5, #06b6d4, #ec4899, #4f46e5);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            animation: hub-spin-grad 3s linear infinite;
        }
        .hub-anim-card-badge {
            position: relative;
            width: 66px;
            height: 66px;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #2563eb 100%);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 14px 28px -6px rgba(79, 70, 229, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.3) inset;
            animation: hub-float-pulse 2.8s ease-in-out infinite;
            overflow: hidden;
        }
        .hub-badge-shimmer {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent 40%,
                rgba(255, 255, 255, 0.45) 50%,
                transparent 60%
            );
            transform: rotate(25deg);
            animation: hub-shimmer-sweep 2.6s ease-in-out infinite;
        }
        .hub-brand-svg {
            width: 36px;
            height: 36px;
            color: #ffffff;
            filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25));
            z-index: 2;
            animation: hub-card-heartbeat 2.8s ease-in-out infinite;
        }
        .hub-dots span {
            display: inline-block;
            animation: hub-dot-blink 1.4s infinite;
            font-weight: 700;
        }
        .hub-dots span:nth-child(2) { animation-delay: 0.2s; }
        .hub-dots span:nth-child(3) { animation-delay: 0.4s; }

        @keyframes hub-ripple {
            0% { transform: scale(0.85); opacity: 0.8; }
            50% { opacity: 0.4; }
            100% { transform: scale(1.6); opacity: 0; }
        }
        @keyframes hub-spin-grad {
            to { transform: rotate(360deg); }
        }
        @keyframes hub-float-pulse {
            0%, 100% {
                transform: translateY(0) scale(1);
                box-shadow: 0 14px 28px -6px rgba(79, 70, 229, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.3) inset;
            }
            50% {
                transform: translateY(-5px) scale(1.04);
                box-shadow: 0 20px 36px -4px rgba(124, 58, 237, 0.65), 0 0 18px rgba(99, 102, 241, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.45) inset;
            }
        }
        @keyframes hub-card-heartbeat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.08); }
        }
        @keyframes hub-shimmer-sweep {
            0% { transform: translateX(-120%) rotate(25deg); }
            100% { transform: translateX(140%) rotate(25deg); }
        }
        @keyframes hub-dot-blink {
            0%, 20% { opacity: 0; }
            50% { opacity: 1; }
            100% { opacity: 0; }
        }
    </style>
</head>
<body class="<%= mode === 'widget' ? 'bg-transparent' : 'bg-base-200' %> min-h-screen flex items-center justify-center p-3 sm:p-6 antialiased relative">
    
    <!-- Écran de chargement avec logo animé SaaS Payment Hub -->
    <div id="checkout-loader-overlay" class="fixed inset-0 bg-base-100/95 backdrop-blur-md z-50 flex flex-col items-center justify-center p-6 text-center transition-all duration-400">
        <div class="hub-anim-logo-container">
            <div class="hub-ripple-ring ring-1"></div>
            <div class="hub-ripple-ring ring-2"></div>
            <div class="hub-orbit-spinner"></div>
            <div class="hub-anim-card-badge">
                <div class="hub-badge-shimmer"></div>
                <svg class="hub-brand-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="2" y="5" width="20" height="14" rx="3" fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="2"/>
                    <path d="M2 10H22" stroke="currentColor" stroke-width="2" stroke-opacity="0.7"/>
                    <rect x="5" y="13" width="4" height="3" rx="0.75" fill="#FDE047"/>
                    <circle cx="17" cy="14.5" r="1.5" fill="#38BDF8"/>
                    <circle cx="14.5" cy="14.5" r="1.5" fill="#F472B6" fill-opacity="0.8"/>
                </svg>
            </div>
        </div>
        <div class="font-black text-base sm:text-lg text-base-content tracking-tight">
            <span id="loader-title-text">SaaS Payment Hub</span>
        </div>
        <div class="text-xs sm:text-sm font-medium text-base-content/60 mt-1 flex items-center justify-center gap-1">
            <span id="loader-sub-text">Sécurisation de votre session</span>
            <span class="hub-dots"><span>.</span><span>.</span><span>.</span></span>
        </div>
        <div class="inline-flex items-center gap-1.5 mt-3.5 bg-base-200 border border-base-300 rounded-full px-3 py-1 text-[11px] font-semibold text-base-content/70 shadow-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-success">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
            </svg>
            <span>Paiement crypté SSL 256-bit</span>
        </div>
    </div>
    
    <!-- Main Payment Card (Marque Blanche) -->
    <div id="payment-card" class="w-full max-w-md <%= mode === 'widget' ? 'bg-base-100' : 'bg-base-100 shadow-2xl' %> rounded-3xl border border-base-300 overflow-hidden my-auto transition-all">
        <div class="p-5 sm:p-8">
            
            <!-- Store Header -->
            <div class="text-center mb-6">
                <% if (locals.storeLogo && storeLogo.trim()) { %>
                    <div class="mb-3 flex justify-center">
                        <img src="<%= storeLogo %>" alt="<%= storeName %>" class="w-16 h-16 rounded-2xl object-contain bg-base-100 shadow-md p-1.5 border border-base-300 max-h-16" onerror="this.parentElement.style.display='none'; document.getElementById('store-fallback-avatar').style.display='inline-flex';" />
                    </div>
                    <div id="store-fallback-avatar" class="avatar placeholder mb-3 hidden">
                        <div class="bg-primary text-primary-content rounded-2xl w-14 h-14 shadow-md flex items-center justify-center font-black text-xl">
                            <span><%= (storeName && storeName.length > 0) ? storeName.charAt(0).toUpperCase() : 'S' %></span>
                        </div>
                    </div>
                <% } else { %>
                    <div class="avatar placeholder mb-3">
                        <div class="bg-primary text-primary-content rounded-2xl w-14 h-14 shadow-md flex items-center justify-center font-black text-xl">
                            <span><%= (storeName && storeName.length > 0) ? storeName.charAt(0).toUpperCase() : 'S' %></span>
                        </div>
                    </div>
                <% } %>
                <h1 class="text-xl sm:text-2xl font-black text-base-content tracking-tight"><%= storeName || 'Boutique' %></h1>
                <div class="flex items-center justify-center gap-1.5 text-xs text-base-content/60 mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span>Paiement 100% sécurisé et crypté</span>
                </div>
            </div>

            <!-- Amount Block -->
            <div class="bg-base-200/80 rounded-2xl p-4 sm:p-5 text-center mb-6 border border-base-300">
                <p class="text-[11px] font-bold uppercase tracking-wider text-base-content/60 mb-1">Montant à régler</p>
                <div class="text-3xl sm:text-4xl font-black text-base-content tracking-tight">
                    <%= Number(session.amount).toLocaleString() %> <span class="text-lg sm:text-xl font-bold opacity-75"><%= session.currency %></span>
                </div>
                <% if (session.description) { %>
                    <div class="badge badge-outline mt-2 text-xs font-medium text-base-content/80 max-w-full truncate px-3 py-1">
                        <%= session.description %>
                    </div>
                <% } %>
            </div>

            <!-- Alert Container for Errors -->
            <div id="error-alert" class="hidden alert alert-error mb-5 text-xs font-semibold py-2.5 px-3.5 rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span id="error-text">Une erreur est survenue.</span>
            </div>

            <!-- Payment Form -->
            <form id="payment-form" action="/checkout/pay" method="POST">
                <input type="hidden" name="token" value="<%= session.token %>">

                <!-- Client Email Badge ou Saisie -->
                <% if (session.customerEmail) { %>
                    <div id="email-badge-container" class="flex items-center justify-between mb-4 bg-base-200/60 p-2.5 px-3.5 rounded-xl border border-base-300 text-xs">
                        <div class="flex items-center gap-2 truncate">
                            <span class="text-base-content/60 shrink-0">Email client :</span>
                            <span id="email-display-badge" class="font-bold text-base-content truncate"><%= session.customerEmail %></span>
                        </div>
                        <button type="button" onclick="toggleEditEmail()" class="btn btn-ghost btn-xs text-[11px] text-primary hover:bg-primary/10 font-medium shrink-0 ml-2">
                            Modifier
                        </button>
                        <input type="hidden" id="checkout-customerEmail" value="<%= session.customerEmail %>">
                    </div>
                    <div id="email-input-container" class="form-control mb-4 hidden">
                        <label class="label py-1"><span class="label-text font-bold text-xs text-base-content/70">Votre adresse email (pour le reçu de paiement)</span></label>
                        <input type="email" id="checkout-customerEmail-edit" value="<%= session.customerEmail %>" placeholder="nom@exemple.com" class="input input-bordered input-sm sm:input-md w-full rounded-xl text-xs sm:text-sm font-medium" oninput="document.getElementById('checkout-customerEmail').value = this.value" />
                    </div>
                <% } else { %>
                    <div class="form-control mb-4">
                        <label class="label py-1"><span class="label-text font-bold text-xs text-base-content/70">Votre adresse email (pour le reçu de paiement)</span></label>
                        <input type="email" id="checkout-customerEmail" placeholder="nom@exemple.com" class="input input-bordered input-sm sm:input-md w-full rounded-xl text-xs sm:text-sm font-medium" />
                    </div>
                <% } %>
                
                <div class="form-control mb-6">
                    <!-- En-tête standard quand tous les modes sont visibles -->
                    <div id="providers-default-header" class="flex items-center justify-between pb-2.5">
                        <span class="label-text font-bold uppercase tracking-wider text-xs text-base-content/70">Choisissez votre mode de paiement</span>
                    </div>

                    <!-- En-tête actif quand DepiPay est sélectionné et isolé -->
                    <div id="depipay-active-header" class="hidden flex items-center justify-between pb-2.5">
                        <span class="label-text font-bold uppercase tracking-wider text-xs text-emerald-700 dark:text-emerald-400 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            Mode Crypto-monnaie (DepiPay)
                        </span>
                        <button type="button" onclick="showAllProviders()" class="btn btn-ghost btn-xs text-primary hover:bg-primary/10 font-bold rounded-lg flex items-center gap-1 transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                            </svg>
                            <span>Changer de moyen</span>
                        </button>
                    </div>

                    <div class="flex flex-col gap-2.5" id="providers-list-container">
                        <% 
                            const defaultCheckedIndex = providers.findIndex(p => p.id !== 'depipay');
                            const checkedIdx = defaultCheckedIndex !== -1 ? defaultCheckedIndex : 0;
                        %>
                        <% providers.forEach(function(provider, index) { %>
                            <div class="provider-option-item flex flex-col" data-provider="<%= provider.id %>">
                                <label id="provider-card-<%= provider.id %>" class="flex items-center gap-3.5 p-3.5 sm:p-4 border-2 border-base-300 rounded-2xl cursor-pointer hover:border-primary/60 hover:bg-base-200/40 transition-all bg-base-100 active:scale-[0.99] group">
                                    <input type="radio" name="provider" value="<%= provider.id %>" class="radio radio-primary radio-sm sm:radio-md" <%= index === checkedIdx ? 'checked' : '' %> required onchange="handleProviderChange(this.value)" />
                                    
                                    <div class="flex-1 flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <% if (provider.id === 'saspay') { %>
                                                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center font-bold text-base shrink-0">
                                                    📱💳
                                                </div>
                                                <div>
                                                    <div class="font-bold text-base-content text-sm sm:text-base">Mobile Money & Carte Bancaire</div>
                                                    <div class="text-xs text-base-content/60 mt-0.5">Wave, Orange Money, MTN MoMo, Moov, Visa, Mastercard</div>
                                                </div>
                                            <% } else if (provider.id === 'lomopay' || provider.id === 'chariow' || provider.id === 'ikeepay') { %>
                                                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold text-lg shrink-0">
                                                    📱
                                                </div>
                                                <div>
                                                    <div class="font-bold text-base-content text-sm sm:text-base">Mobile Money</div>
                                                    <div class="text-xs text-base-content/60 mt-0.5">Wave, Orange Money, MTN MoMo, Moov</div>
                                                </div>
                                            <% } else if (provider.id === 'stripe' || provider.id === 'whop') { %>
                                                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center font-bold text-lg shrink-0">
                                                    💳
                                                </div>
                                                <div>
                                                    <div class="font-bold text-base-content text-sm sm:text-base">Carte Bancaire</div>
                                                    <div class="text-xs text-base-content/60 mt-0.5">Visa, Mastercard, Apple Pay, Google Pay</div>
                                                </div>
                                            <% } else if (provider.id === 'depipay') { %>
                                                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold text-lg shrink-0">
                                                    🪙
                                                </div>
                                                <div>
                                                    <div class="font-bold text-base-content text-sm sm:text-base">Crypto-monnaies (DepiPay)</div>
                                                    <div class="text-xs text-base-content/60 mt-0.5">BSC, TRON, Ethereum (USDT, USDC, BNB, TRX, ETH)</div>
                                                </div>
                                            <% } else { %>
                                                <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-lg shrink-0">
                                                    ⚡
                                                </div>
                                                <div>
                                                    <div class="font-bold text-base-content text-sm sm:text-base"><%= provider.name %></div>
                                                    <div class="text-xs text-base-content/60 mt-0.5">Paiement sécurisé</div>
                                                </div>
                                            <% } %>
                                        </div>

                                        <div class="flex items-center gap-2">
                                            <% if (provider.id === 'depipay') { %>
                                                <span id="depipay-selected-badge" class="badge badge-sm badge-success text-white font-bold hidden">Sélectionné</span>
                                            <% } %>
                                            <div class="text-xs font-bold text-base-content/40 uppercase tracking-wider group-hover:text-primary transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                </label>

                                <% if (provider.id === 'depipay') { %>
                                    <!-- Étape intermédiaire de sélection Crypto (Blockchain & Jeton) -->
                                    <div id="depipay-selection-panel" class="hidden mt-2 p-3 sm:p-4 bg-base-100 rounded-2xl border-2 border-emerald-500/40 shadow-sm space-y-3.5">
                                        <div>
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="text-xs font-black uppercase tracking-wider text-base-content/80 flex items-center gap-1.5">
                                                    <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[11px] font-bold">1</span>
                                                    Choisissez la Blockchain
                                                </span>
                                                <span class="text-[10px] text-base-content/50 font-medium">Étape 1/2</span>
                                            </div>
                                            <div class="grid grid-cols-3 gap-2" id="crypto-network-group">
                                                <button type="button" class="crypto-net-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 transition-all border-emerald-500 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 font-bold shadow-xs" data-net="bsc" onclick="selectCryptoNetwork('bsc')">
                                                    <span class="text-lg">🟡</span>
                                                    <span class="text-xs font-black mt-0.5">BSC</span>
                                                    <span class="text-[9px] text-emerald-600 dark:text-emerald-400 font-medium">Frais ~0.05$</span>
                                                </button>
                                                <button type="button" class="crypto-net-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 transition-all bg-base-200/60 border-base-300 text-base-content/70 font-bold hover:border-base-content/30" data-net="tron" onclick="selectCryptoNetwork('tron')">
                                                    <span class="text-lg">🔴</span>
                                                    <span class="text-xs font-black mt-0.5">TRON</span>
                                                    <span class="text-[9px] text-base-content/50 font-medium">Frais ~1$</span>
                                                </button>
                                                <button type="button" class="crypto-net-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 transition-all bg-base-200/60 border-base-300 text-base-content/70 font-bold hover:border-base-content/30" data-net="ethereum" onclick="selectCryptoNetwork('ethereum')">
                                                    <span class="text-lg">🔷</span>
                                                    <span class="text-xs font-black mt-0.5">Ethereum</span>
                                                    <span class="text-[9px] text-base-content/50 font-medium">ERC-20</span>
                                                </button>
                                            </div>
                                        </div>

                                        <div>
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="text-xs font-black uppercase tracking-wider text-base-content/80 flex items-center gap-1.5">
                                                    <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[11px] font-bold">2</span>
                                                    Choisissez le Jeton (Token)
                                                </span>
                                                <span class="text-[10px] text-base-content/50 font-medium">Étape 2/2</span>
                                            </div>
                                            <div class="grid grid-cols-3 gap-2" id="crypto-tokens-container">
                                                <!-- Rempli dynamiquement en JS -->
                                            </div>
                                        </div>

                                        <div class="text-xs font-semibold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/30 p-2.5 rounded-xl border border-emerald-200/80 dark:border-emerald-800/60 flex items-center justify-between">
                                            <span class="flex items-center gap-1.5">
                                                <span class="text-base text-emerald-600">✓</span>
                                                <span>Paiement en <strong id="summary-token-name" class="font-black text-emerald-900 dark:text-emerald-200">USDT</strong> sur <strong id="summary-net-name" class="font-black text-emerald-900 dark:text-emerald-200">BSC (BNB Chain)</strong></span>
                                            </span>
                                            <span class="badge badge-sm badge-success text-[10px] font-bold text-white uppercase">Prêt</span>
                                        </div>

                                        <!-- Bouton retour / choisir un autre moyen -->
                                        <div class="pt-1 text-center">
                                            <button type="button" onclick="showAllProviders()" class="btn btn-ghost btn-xs text-base-content/60 hover:text-primary font-medium flex items-center justify-center gap-1 mx-auto transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                                                </svg>
                                                <span>Choisir un autre moyen (Mobile Money, Carte...)</span>
                                            </button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <div class="flex flex-col gap-2.5">
                    <button type="submit" id="submit-btn" class="btn btn-primary btn-block shadow-lg font-bold text-base min-h-[48px] h-12 rounded-xl">
                        <span>Payer</span>
                    </button>
                    
                    <% if (session.cancelUrl) { %>
                        <button type="button" id="cancel-btn" class="btn btn-ghost btn-sm btn-block font-medium text-xs text-base-content/60 hover:text-error">
                            Annuler et retourner au site
                        </button>
                    <% } %>
                </div>
            </form>

            <!-- Écran de paiement Crypto direct SANS REDIRECTION -->
            <div id="crypto-direct-pay-container" class="hidden space-y-4 text-center pt-1">
                <!-- En-tête statut -->
                <div class="bg-emerald-500/10 border-2 border-emerald-500/30 rounded-2xl p-3.5 text-emerald-800 dark:text-emerald-200">
                    <div class="flex items-center justify-between text-xs mb-1 font-bold">
                        <span class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                            <span>Facture Crypto Prête</span>
                        </span>
                        <span id="crypto-direct-network-badge" class="badge badge-sm badge-success text-white font-mono text-[10px] uppercase">BSC</span>
                    </div>
                    <div class="text-2xl sm:text-3xl font-black tracking-tight text-base-content mt-1">
                        <span id="crypto-direct-amount">0.00</span> <span id="crypto-direct-token" class="text-lg text-emerald-600 dark:text-emerald-400 font-bold">USDT</span>
                    </div>
                    <p class="text-[11px] opacity-75 mt-0.5">Envoyez exactement ce montant à l'adresse ci-dessous</p>

                    <div class="mt-2.5 pt-2 border-t border-emerald-500/20 flex items-center justify-between text-xs">
                        <span class="font-medium opacity-80 flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>Expire dans :</span>
                        </span>
                        <span id="crypto-countdown-timer" class="font-mono font-black text-xs px-2.5 py-0.5 rounded-lg bg-emerald-500/20 text-emerald-900 dark:text-emerald-100">15:00</span>
                    </div>
                </div>

                <!-- QR Code centré -->
                <div class="flex flex-col items-center justify-center p-3 bg-white rounded-2xl border-2 border-base-300 shadow-sm max-w-[210px] mx-auto">
                    <img id="crypto-direct-qr" src="" alt="QR Code Paiement" class="w-40 h-40 object-contain rounded-xl" />
                    <span class="text-[10px] font-bold text-slate-500 mt-1">Scannez avec votre wallet</span>
                </div>

                <!-- Adresse de dépôt & Bouton Copier -->
                <div class="space-y-1.5 text-left">
                    <label class="text-[11px] font-bold uppercase tracking-wider text-base-content/60 flex items-center justify-between px-0.5">
                        <span>Adresse de dépôt</span>
                        <span id="copy-feedback" class="text-success text-[10px] font-bold hidden">✓ Adresse copiée !</span>
                    </label>
                    <div class="flex items-center gap-1.5 bg-base-200/80 p-2 rounded-xl border border-base-300">
                        <input type="text" id="crypto-direct-address" readonly class="input input-xs bg-transparent border-none font-mono text-xs text-base-content flex-1 truncate select-all focus:outline-none" />
                        <button type="button" id="copy-address-btn" onclick="copyCryptoAddress()" class="btn btn-primary btn-xs rounded-lg font-bold shrink-0">
                            Copier
                        </button>
                    </div>
                </div>

                <!-- Détection Blockchain en direct -->
                <div class="bg-base-200/60 rounded-xl p-3 border border-base-300 flex items-center gap-3 text-left">
                    <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-600 flex items-center justify-center shrink-0">
                        <span class="loading loading-spinner loading-xs text-emerald-600"></span>
                    </div>
                    <div class="text-xs">
                        <div class="font-bold text-base-content flex items-center gap-1.5">
                            <span>Détection automatique en direct</span>
                            <span class="flex h-1.5 w-1.5 relative"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span></span>
                        </div>
                        <div class="text-[11px] text-base-content/60">Validation instantanée dès confirmation sur la blockchain.</div>
                    </div>
                </div>

                <!-- Boutons d'action et retour -->
                <div class="flex flex-col gap-1.5 pt-1">
                    <a id="crypto-direct-external-link" href="#" target="_blank" class="btn btn-ghost btn-xs text-base-content/60 hover:text-primary font-medium text-[11px]">
                        Ouvrir sur le portail DepiPay.com ↗
                    </a>
                    <button type="button" onclick="cancelCryptoDirectPay()" class="btn btn-ghost btn-xs text-error font-medium text-[11px]">
                        Annuler / Choisir un autre moyen
                    </button>
                </div>
            </div>

            <!-- Écran de Succès in-page SANS REDIRECTION -->
            <div id="direct-pay-success-container" class="hidden space-y-4 text-center py-6">
                <div class="w-16 h-16 rounded-full bg-success/20 text-success mx-auto flex items-center justify-center text-3xl font-black animate-bounce">
                    ✓
                </div>
                <h2 class="text-2xl font-black text-base-content tracking-tight">Paiement Validé !</h2>
                <p class="text-xs text-base-content/60 max-w-xs mx-auto">Votre transfert a été confirmé avec succès sur la blockchain. Votre compte est immédiatement crédité.</p>
                <div class="badge badge-success text-white font-bold text-xs py-2.5 px-3.5">
                    Transaction confirmée
                </div>
            </div>

        </div>
        
        <!-- Footer security badge -->
        <div class="bg-base-200/60 p-3.5 border-t border-base-300 text-center text-[11px] text-base-content/50 flex items-center justify-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Transactions protégées par cryptage SSL 256-bit</span>
        </div>
    </div>

    <script>
        const form = document.getElementById('payment-form');
        const submitBtn = document.getElementById('submit-btn');
        const errorAlert = document.getElementById('error-alert');
        const errorText = document.getElementById('error-text');
        const loaderOverlay = document.getElementById('checkout-loader-overlay');
        const loaderTitle = document.getElementById('loader-title-text');
        const loaderSub = document.getElementById('loader-sub-text');

        function toggleEditEmail() {
            const badge = document.getElementById('email-badge-container');
            const inputContainer = document.getElementById('email-input-container');
            if (badge && inputContainer) {
                badge.classList.add('hidden');
                inputContainer.classList.remove('hidden');
                const editInput = document.getElementById('checkout-customerEmail-edit');
                if (editInput) {
                    editInput.focus();
                    editInput.select();
                }
            }
        }

        // Configuration multi-chain & tokens DepiPay
        const CRYPTO_CONFIG = {
            bsc: {
                name: 'BSC (BNB Chain)',
                badge: 'Frais minimes (~0.05$)',
                tokens: [
                    { symbol: 'USDC', name: 'USD Coin', icon: '💲', badge: 'BEP-20' },
                    { symbol: 'USDT', name: 'Tether USD', icon: '₮', badge: 'BEP-20' },
                    { symbol: 'BNB', name: 'BNB', icon: '🟡', badge: 'Natif' }
                ]
            },
            tron: {
                name: 'TRON Network',
                badge: 'Frais faibles (~1$)',
                tokens: [
                    { symbol: 'USDT', name: 'Tether USD', icon: '₮', badge: 'TRC-20' },
                    { symbol: 'TRON', name: 'TRON (TRX)', icon: '🔴', badge: 'Natif' }
                ]
            },
            ethereum: {
                name: 'Ethereum (ERC-20)',
                badge: 'Frais standard',
                tokens: [
                    { symbol: 'ETHER', name: 'Ether (ETH)', icon: '🔷', badge: 'Natif' },
                    { symbol: 'USDT', name: 'Tether USD', icon: '₮', badge: 'ERC-20' },
                    { symbol: 'USDC', name: 'USD Coin', icon: '💲', badge: 'ERC-20' }
                ]
            }
        };

        let selectedCryptoNetwork = 'bsc';
        let selectedCryptoToken = 'USDT';

        function renderCryptoTokens() {
            const container = document.getElementById('crypto-tokens-container');
            if (!container) return;

            const netData = CRYPTO_CONFIG[selectedCryptoNetwork];
            if (!netData) return;

            // Vérifier si le jeton sélectionné est valide pour ce réseau, sinon prendre le 1er ou USDT
            const hasCurrent = netData.tokens.some(t => t.symbol === selectedCryptoToken);
            if (!hasCurrent) {
                const hasUsdt = netData.tokens.find(t => t.symbol === 'USDT');
                selectedCryptoToken = hasUsdt ? 'USDT' : netData.tokens[0].symbol;
            }

            container.innerHTML = '';
            netData.tokens.forEach(tok => {
                const isSelected = tok.symbol === selectedCryptoToken;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `crypto-token-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 transition-all font-bold ${
                    isSelected 
                        ? 'border-emerald-500 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 shadow-xs' 
                        : 'bg-base-200/60 border-base-300 text-base-content/70 hover:border-base-content/30'
                }`;
                btn.onclick = () => selectCryptoToken(tok.symbol);
                btn.innerHTML = `
                    <span class="text-base">${tok.icon}</span>
                    <span class="text-xs font-black mt-0.5">${tok.symbol}</span>
                    <span class="text-[9px] ${isSelected ? 'text-emerald-600 dark:text-emerald-400 font-bold' : 'text-base-content/50 font-medium'}">${tok.badge}</span>
                `;
                container.appendChild(btn);
            });

            updateCryptoSummary();
        }

        function selectCryptoNetwork(net) {
            selectedCryptoNetwork = net;

            const netButtons = document.querySelectorAll('#crypto-network-group .crypto-net-btn');
            netButtons.forEach(btn => {
                const btnNet = btn.getAttribute('data-net');
                if (btnNet === net) {
                    btn.className = 'crypto-net-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 transition-all border-emerald-500 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 font-bold shadow-xs';
                    const sub = btn.querySelector('span:last-child');
                    if (sub) sub.className = 'text-[9px] text-emerald-600 dark:text-emerald-400 font-medium';
                } else {
                    btn.className = 'crypto-net-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 transition-all bg-base-200/60 border-base-300 text-base-content/70 font-bold hover:border-base-content/30';
                    const sub = btn.querySelector('span:last-child');
                    if (sub) sub.className = 'text-[9px] text-base-content/50 font-medium';
                }
            });

            renderCryptoTokens();
        }

        function selectCryptoToken(symbol) {
            selectedCryptoToken = symbol;
            renderCryptoTokens();
        }

        function updateCryptoSummary() {
            const summaryToken = document.getElementById('summary-token-name');
            const summaryNet = document.getElementById('summary-net-name');
            if (summaryToken) summaryToken.textContent = selectedCryptoToken;
            if (summaryNet && CRYPTO_CONFIG[selectedCryptoNetwork]) {
                summaryNet.textContent = CRYPTO_CONFIG[selectedCryptoNetwork].name;
            }

            const providerInput = document.querySelector('input[name="provider"]:checked');
            if (providerInput && providerInput.value === 'depipay' && submitBtn) {
                submitBtn.className = 'btn btn-block shadow-lg font-bold text-base min-h-[48px] h-12 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white border-none transition-all';
                submitBtn.innerHTML = `<span>Payer en ${selectedCryptoToken} (${selectedCryptoNetwork.toUpperCase()})</span>`;
            }
        }

        function handleProviderChange(providerVal) {
            const depiPanel = document.getElementById('depipay-selection-panel');
            const depiHeader = document.getElementById('depipay-active-header');
            const defaultHeader = document.getElementById('providers-default-header');
            const depiBadge = document.getElementById('depipay-selected-badge');
            const depiCard = document.getElementById('provider-card-depipay');

            if (providerVal === 'depipay') {
                // 1. Masquer tous les autres moyens de paiement
                document.querySelectorAll('.provider-option-item').forEach(el => {
                    if (el.getAttribute('data-provider') !== 'depipay') {
                        el.classList.add('hidden');
                    } else {
                        el.classList.remove('hidden');
                    }
                });

                // 2. En-tête mode crypto actif
                if (depiHeader) depiHeader.classList.remove('hidden');
                if (defaultHeader) defaultHeader.classList.add('hidden');

                // 3. Mise en valeur de la carte DepiPay
                if (depiCard) {
                    depiCard.classList.remove('border-base-300');
                    depiCard.classList.add('border-emerald-500', 'bg-emerald-500/5', 'ring-2', 'ring-emerald-500/20');
                }
                if (depiBadge) depiBadge.classList.remove('hidden');

                // 4. Affichage du panneau crypto (Blockchain + Tokens)
                if (depiPanel) {
                    depiPanel.classList.remove('hidden');
                    renderCryptoTokens();
                }

                // 5. Bouton de soumission vert
                if (submitBtn) {
                    submitBtn.className = 'btn btn-block shadow-lg font-bold text-base min-h-[48px] h-12 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white border-none transition-all';
                    submitBtn.innerHTML = `<span>Payer en ${selectedCryptoToken} (${selectedCryptoNetwork.toUpperCase()})</span>`;
                    submitBtn.disabled = false;
                }
            } else {
                // 1. Réafficher tous les moyens de paiement
                document.querySelectorAll('.provider-option-item').forEach(el => {
                    el.classList.remove('hidden');
                });

                // 2. Rétablir l'en-tête standard
                if (depiHeader) depiHeader.classList.add('hidden');
                if (defaultHeader) defaultHeader.classList.remove('hidden');

                // 3. Réinitialiser la carte DepiPay
                if (depiCard) {
                    depiCard.classList.remove('border-emerald-500', 'bg-emerald-500/5', 'ring-2', 'ring-emerald-500/20');
                    depiCard.classList.add('border-base-300');
                }
                if (depiBadge) depiBadge.classList.add('hidden');

                // 4. Masquer le panneau crypto
                if (depiPanel) {
                    depiPanel.classList.add('hidden');
                }

                // 5. Rétablir bouton standard
                if (submitBtn) {
                    submitBtn.className = 'btn btn-primary btn-block shadow-lg font-bold text-base min-h-[48px] h-12 rounded-xl';
                    submitBtn.innerHTML = '<span>Payer</span>';
                    submitBtn.disabled = false;
                }
            }
        }

        function showAllProviders() {
            // 1. Réafficher tous les moyens de paiement
            document.querySelectorAll('.provider-option-item').forEach(el => {
                el.classList.remove('hidden');
            });

            // 2. Rétablir l'en-tête standard
            const depiHeader = document.getElementById('depipay-active-header');
            const defaultHeader = document.getElementById('providers-default-header');
            if (depiHeader) depiHeader.classList.add('hidden');
            if (defaultHeader) defaultHeader.classList.remove('hidden');

            // 3. Masquer le panneau DepiPay et retirer la surbrillance
            const depiPanel = document.getElementById('depipay-selection-panel');
            const depiBadge = document.getElementById('depipay-selected-badge');
            const depiCard = document.getElementById('provider-card-depipay');
            if (depiPanel) depiPanel.classList.add('hidden');
            if (depiBadge) depiBadge.classList.add('hidden');
            if (depiCard) {
                depiCard.classList.remove('border-emerald-500', 'bg-emerald-500/5', 'ring-2', 'ring-emerald-500/20');
                depiCard.classList.add('border-base-300');
            }

            // 4. Décocher le radio DepiPay afin de permettre un nouveau choix
            const depiRadio = document.querySelector('input[name="provider"][value="depipay"]');
            if (depiRadio) depiRadio.checked = false;

            // 5. Bouton de soumission
            if (submitBtn) {
                submitBtn.className = 'btn btn-primary btn-block shadow-lg font-bold text-base min-h-[48px] h-12 rounded-xl';
                submitBtn.innerHTML = '<span>Payer</span>';
            }
        }

        // =========================================================================
        // GESTION PAIEMENT CRYPTO DIRECT IN-PAGE (SANS AUCUNE REDIRECTION)
        // =========================================================================
        let cryptoPollingTimer = null;
        let cryptoCountdownTimer = null;

        function startCryptoCountdown(durationSecs = 900) {
            stopCryptoCountdown();
            let remaining = Number(durationSecs) || 900;
            const timerEl = document.getElementById('crypto-countdown-timer');

            const updateDisplay = () => {
                if (!timerEl) return;
                const m = Math.floor(remaining / 60);
                const s = remaining % 60;
                timerEl.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;

                if (remaining <= 120) {
                    timerEl.className = 'font-mono font-black text-xs px-2.5 py-0.5 rounded-lg bg-error/20 text-error animate-pulse';
                } else if (remaining <= 300) {
                    timerEl.className = 'font-mono font-black text-xs px-2.5 py-0.5 rounded-lg bg-warning/20 text-warning';
                } else {
                    timerEl.className = 'font-mono font-black text-xs px-2.5 py-0.5 rounded-lg bg-emerald-500/20 text-emerald-900 dark:text-emerald-100';
                }
            };

            updateDisplay();
            cryptoCountdownTimer = setInterval(() => {
                remaining--;
                if (remaining <= 0) {
                    stopCryptoCountdown();
                    stopSessionStatusPolling();
                    if (timerEl) {
                        timerEl.textContent = 'Expirée (15m)';
                        timerEl.className = 'font-mono font-black text-xs px-2.5 py-0.5 rounded-lg bg-error text-white';
                    }
                    showError('La facture crypto a expiré (validité de 15 minutes dépassée). Veuillez relancer le paiement.');
                    cancelCryptoDirectPay();
                    return;
                }
                updateDisplay();
            }, 1000);
        }

        function stopCryptoCountdown() {
            if (cryptoCountdownTimer) {
                clearInterval(cryptoCountdownTimer);
                cryptoCountdownTimer = null;
            }
        }

        function renderCryptoDirectPayment(details, checkoutUrl) {
            const formEl = document.getElementById('payment-form');
            const cryptoContainer = document.getElementById('crypto-direct-pay-container');
            if (formEl) formEl.classList.add('hidden');
            if (cryptoContainer) cryptoContainer.classList.remove('hidden');

            const netBadge = document.getElementById('crypto-direct-network-badge');
            const amountEl = document.getElementById('crypto-direct-amount');
            const tokenEl = document.getElementById('crypto-direct-token');
            const addressInput = document.getElementById('crypto-direct-address');
            const qrImg = document.getElementById('crypto-direct-qr');
            const extLink = document.getElementById('crypto-direct-external-link');

            const tokenSymbol = details.cryptoToken || selectedCryptoToken || 'USDT';
            const netKey = details.network || selectedCryptoNetwork || 'bsc';
            const netName = CRYPTO_CONFIG[netKey]?.name || netKey.toUpperCase();

            if (netBadge) netBadge.textContent = netName;
            if (amountEl) amountEl.textContent = details.value;
            if (tokenEl) tokenEl.textContent = tokenSymbol;
            if (addressInput) addressInput.value = details.address;
            if (extLink && checkoutUrl) extLink.href = checkoutUrl;

            if (qrImg && details.address) {
                qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(details.address)}`;
            }

            // Lancement du compte à rebours de 15 minutes
            startCryptoCountdown(details.deadlineSecs || 900);
        }

        function copyCryptoAddress() {
            const addressInput = document.getElementById('crypto-direct-address');
            const copyFeedback = document.getElementById('copy-feedback');
            const copyBtn = document.getElementById('copy-address-btn');

            if (addressInput && addressInput.value) {
                navigator.clipboard.writeText(addressInput.value).then(() => {
                    if (copyFeedback) copyFeedback.classList.remove('hidden');
                    if (copyBtn) copyBtn.textContent = 'Copié !';
                    setTimeout(() => {
                        if (copyFeedback) copyFeedback.classList.add('hidden');
                        if (copyBtn) copyBtn.textContent = 'Copier';
                    }, 2500);
                }).catch(() => {
                    addressInput.select();
                    document.execCommand('copy');
                    if (copyBtn) copyBtn.textContent = 'Copié !';
                    setTimeout(() => { if (copyBtn) copyBtn.textContent = 'Copier'; }, 2000);
                });
            }
        }

        function cancelCryptoDirectPay() {
            stopCryptoCountdown();
            stopSessionStatusPolling();
            const formEl = document.getElementById('payment-form');
            const cryptoContainer = document.getElementById('crypto-direct-pay-container');
            if (cryptoContainer) cryptoContainer.classList.add('hidden');
            if (formEl) formEl.classList.remove('hidden');
            showAllProviders();
        }

        function startSessionStatusPolling() {
            stopSessionStatusPolling();
            const sessionToken = "<%= session.token %>";
            const orderId = "<%= session.orderId %>";
            const returnUrl = "<%= session.returnUrl %>";

            cryptoPollingTimer = setInterval(async () => {
                try {
                    const res = await fetch(`/checkout/status/${sessionToken}`);
                    if (!res.ok) return;
                    const statusData = await res.json();

                    if (statusData.status === 'succeeded') {
                        stopCryptoCountdown();
                        stopSessionStatusPolling();

                        // Affichage écran de succès in-page
                        const cryptoContainer = document.getElementById('crypto-direct-pay-container');
                        const successContainer = document.getElementById('direct-pay-success-container');
                        if (cryptoContainer) cryptoContainer.classList.add('hidden');
                        if (successContainer) successContainer.classList.remove('hidden');

                        const payload = {
                            type: 'HUB_PAYMENT_SUCCESS',
                            status: 'success',
                            orderId: orderId,
                            token: sessionToken
                        };

                        // Notifier le site parent (Iframe Modale in-app)
                        if (window.parent && window.parent !== window) {
                            try {
                                window.parent.postMessage(payload, '*');
                                window.parent.postMessage('payment_success', '*');
                                window.parent.postMessage('whop:payment:success', '*');
                            } catch (e) {}
                        }

                        // Notifier la fenêtre parente (Popup)
                        if (window.opener && window.opener !== window) {
                            try {
                                window.opener.postMessage(payload, '*');
                                window.opener.postMessage('payment_success', '*');
                            } catch (e) {}
                            setTimeout(() => window.close(), 1800);
                        } else if (window.self === window.top && returnUrl && returnUrl.startsWith('http')) {
                            // Si mode pleine page classique autonome, redirection vers returnUrl après 2s
                            setTimeout(() => {
                                window.location.href = returnUrl;
                            }, 2000);
                        }
                    }
                } catch (e) {
                    console.warn('[Polling Status] Erreur:', e);
                }
            }, 2500);
        }

        function stopSessionStatusPolling() {
            if (cryptoPollingTimer) {
                clearInterval(cryptoPollingTimer);
                cryptoPollingTimer = null;
            }
        }

        // Animation d'entrée douce au chargement de la page & initialisation
        window.addEventListener('DOMContentLoaded', () => {
            const checkedProvider = document.querySelector('input[name="provider"]:checked');
            if (checkedProvider) {
                handleProviderChange(checkedProvider.value);
            }

            setTimeout(() => {
                if (loaderOverlay) {
                    loaderOverlay.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
                    setTimeout(() => {
                        loaderOverlay.style.display = 'none';
                    }, 400);
                }
            }, 350);
        });

        function showOverlayLoader(title, subtitle) {
            if (!loaderOverlay) return;
            if (loaderTitle && title) loaderTitle.textContent = title;
            if (loaderSub && subtitle) loaderSub.textContent = subtitle;
            
            loaderOverlay.style.display = 'flex';
            requestAnimationFrame(() => {
                loaderOverlay.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
                loaderOverlay.classList.add('opacity-100', 'scale-100');
            });
        }

        function hideOverlayLoader() {
            if (!loaderOverlay) return;
            loaderOverlay.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
            setTimeout(() => {
                loaderOverlay.style.display = 'none';
            }, 400);
        }

        const isDev = <%= Boolean(locals.isDev) %>;

        function sanitizeErrorMessage(msg) {
            if (!msg || typeof msg !== 'string') {
                return 'Une erreur temporaire est survenue. Veuillez réessayer.';
            }
            // En PRODUCTION : masquer impérativement les erreurs techniques brutes (HTTP, JSON, codes, adresses 0x, etc.)
            if (!isDev) {
                const isTechnical = /HTTP|\b(429|500|502|503|400|404)\b|owner\s+0x|unpaid\s+invoices|stack|exception|Unexpected|non-JSON/i.test(msg);
                if (isTechnical) {
                    return 'Ce moyen de paiement est momentanément indisponible. Veuillez sélectionner un autre mode de paiement (Mobile Money, Carte...) ou réessayer dans quelques instants.';
                }
            }
            // En DEV : conserver le détail de l'erreur pour faciliter le débogage
            return msg;
        }

        function showError(msg) {
            console.error('[Checkout Error]:', msg);
            hideOverlayLoader();
            errorText.textContent = sanitizeErrorMessage(msg);
            errorAlert.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Réessayer</span>';
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorAlert.classList.add('hidden');

            const providerInput = document.querySelector('input[name="provider"]:checked');
            if (!providerInput) {
                showError('Veuillez sélectionner un moyen de paiement pour continuer.');
                return;
            }

            const emailInput = document.getElementById('checkout-customerEmail');
            const customerEmail = emailInput ? emailInput.value.trim() : undefined;
            const providerVal = providerInput.value;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Initialisation sécurisée...';

            let providerDisplay = 'sécurisé';
            if (providerVal === 'lomopay') providerDisplay = 'Mobile Money';
            else if (providerVal === 'saspay') providerDisplay = 'Mobile Money & Carte Bancaire';
            else if (providerVal === 'ikeepay') providerDisplay = 'Mobile Money';
            else if (providerVal === 'whop') providerDisplay = 'Carte Bancaire';
            else if (providerVal === 'stripe') providerDisplay = 'Carte Bancaire';
            else if (providerVal === 'depipay') {
                const netName = CRYPTO_CONFIG[selectedCryptoNetwork]?.name || selectedCryptoNetwork.toUpperCase();
                providerDisplay = `Crypto (${selectedCryptoToken} sur ${netName})`;
            }

            showOverlayLoader("Connexion sécurisée...", `Ouverture du tunnel ${providerDisplay}`);

            const payload = {
                token: document.querySelector('input[name="token"]').value,
                provider: providerVal,
                customerEmail: customerEmail
            };

            if (providerVal === 'depipay') {
                payload.cryptoNetwork = selectedCryptoNetwork;
                payload.cryptoToken = selectedCryptoToken;
            }

            try {
                const response = await fetch('/checkout/pay', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (data.cryptoDetails && data.cryptoDetails.address) {
                    // Mode Crypto SANS AUCUNE REDIRECTION : affichage direct in-page / dans la modale
                    hideOverlayLoader();
                    renderCryptoDirectPayment(data.cryptoDetails, data.checkoutUrl);
                    startSessionStatusPolling();
                    return;
                }

                if (data.checkoutUrl) {
                    showOverlayLoader("Connexion en cours...", "Ouverture de votre espace de paiement");
                    const isWidgetOrPopup = "<%= mode %>" === "widget" || "<%= mode %>" === "popup";

                    if (isWidgetOrPopup) {
                        // Mode POP-UP SANS REDIRECTION : on reste dans la frame/popup sans rediriger le site parent
                        window.location.href = data.checkoutUrl;
                    } else if (window.self !== window.top) {
                        window.top.location.href = data.checkoutUrl;
                    } else {
                        // Mode REDIRECTION CLASSIQUE : navigation pleine page normale
                        window.location.href = data.checkoutUrl;
                    }
                } else {
                    showError(data.error || 'Impossible d’initialiser le paiement.');
                }
            } catch (err) {
                showError('Erreur de connexion. Veuillez vérifier votre réseau.');
            }
        });

        const cancelBtn = document.getElementById('cancel-btn');
        if (cancelBtn) {
            cancelBtn.addEventListener('click', (e) => {
                e.preventDefault();
                const cancelUrl = "<%= session.cancelUrl %>";
                const cancelPayload = {
                    type: 'HUB_PAYMENT_CANCEL',
                    status: 'cancelled',
                    token: "<%= session.token %>",
                    orderId: "<%= session.orderId %>"
                };

                const isWidgetOrPopup = "<%= mode %>" === "widget" || "<%= mode %>" === "popup";

                // 1. Détection Iframe (Modale Pop-up intégrée sur le site)
                if (window.parent && window.parent !== window) {
                    try {
                        window.parent.postMessage(cancelPayload, '*');
                        window.parent.postMessage({ type: 'HUB_PAYMENT_CLOSE' }, '*');
                        window.parent.postMessage('ikeepay-close', '*');
                        window.parent.postMessage('payment_cancel', '*');
                    } catch (err) {}

                    // En mode widget/popup, on ne redirige pas le parent : la modale se ferme sur place
                    if (!isWidgetOrPopup && cancelUrl && cancelUrl.startsWith('http') && !cancelUrl.includes('mode=widget')) {
                        setTimeout(() => {
                            try {
                                window.top.location.href = cancelUrl;
                            } catch (e) {}
                        }, 200);
                    }
                } 
                // 2. Détection Popup Fenêtre indépendante
                else if (window.opener && window.opener !== window) {
                    try {
                        window.opener.postMessage(cancelPayload, '*');
                        window.opener.postMessage('payment_cancel', '*');
                    } catch (err) {}
                    window.close();
                } 
                // 3. Mode Redirection pleine page normale
                else {
                    if (cancelUrl && cancelUrl.startsWith('http')) {
                        window.location.href = cancelUrl;
                    }
                }
            });
        }
    </script>
</body>
</html>
