<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Paiement Sécurisé | <%= storeName || 'Boutique' %></title>
    
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root, [data-theme="light"] {
            color-scheme: light;
            --color-base-100: oklch(100% 0 0);
            --color-base-200: oklch(98% 0 0);
            --color-base-300: oklch(95% 0 0);
            --color-base-content: oklch(21% 0.006 285.885);
            --color-primary: oklch(45% 0.24 277.023);
            --color-primary-content: oklch(93% 0.034 272.788);
            --p: 45% 0.24 277.023;
            --pc: 93% 0.034 272.788;
            --b1: 100% 0 0;
            --b2: 98% 0 0;
            --b3: 95% 0 0;
            --bc: 21% 0.006 285.885;
            --rounded-box: 1rem;
            --rounded-btn: 0.75rem;
        }
        body { font-family: 'Inter', sans-serif; }
        input, button, label { -webkit-tap-highlight-color: transparent; }
    </style>
</head>
<body class="<%= mode === 'widget' ? 'bg-transparent' : 'bg-base-200' %> min-h-screen flex items-center justify-center p-3 sm:p-6 antialiased">
    
    <!-- Main Payment Card -->
    <div id="payment-card" class="w-full max-w-md <%= mode === 'widget' ? 'bg-base-100' : 'bg-base-100 shadow-2xl' %> rounded-3xl border border-base-300 overflow-hidden my-auto transition-all">
        <div class="p-5 sm:p-8">
            
            <!-- Store Header (Marque Blanche) -->
            <div class="text-center mb-6">
                <div class="avatar placeholder mb-3">
                    <div class="bg-primary text-primary-content rounded-2xl w-14 h-14 shadow-md flex items-center justify-center font-black text-xl">
                        <span><%= (storeName && storeName.length > 0) ? storeName.charAt(0).toUpperCase() : 'S' %></span>
                    </div>
                </div>
                <h1 class="text-xl sm:text-2xl font-black text-base-content tracking-tight"><%= storeName || 'Boutique' %></h1>
                <div class="flex items-center justify-center gap-1.5 text-xs text-base-content/60 mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span>Paiement 100% sécurisé et crypté</span>
                </div>
            </div>

            <!-- Amount Block -->
            <div class="bg-base-200/80 rounded-2xl p-4 sm:p-5 text-center mb-6 border border-base-300">
                <p class="text-[11px] font-bold uppercase tracking-wider text-base-content/60 mb-1">Montant à régler</p>
                <div class="text-3xl sm:text-4xl font-black text-base-content tracking-tight">
                    <%= Number(session.amount).toLocaleString() %> <span class="text-lg sm:text-xl font-bold opacity-75"><%= session.currency %></span>
                </div>
                <% if (session.description) { %>
                    <div class="badge badge-outline mt-2 text-xs font-medium text-base-content/80 max-w-full truncate px-3 py-1">
                        <%= session.description %>
                    </div>
                <% } %>
            </div>

            <!-- Alert Container for Errors -->
            <div id="error-alert" class="hidden alert alert-error mb-5 text-xs font-semibold py-2.5 px-3.5 rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span id="error-text">Une erreur est survenue.</span>
            </div>

            <!-- Payment Form -->
            <form id="payment-form" action="/checkout/pay" method="POST">
                <input type="hidden" name="token" value="<%= session.token %>">
                
                <div class="form-control mb-6">
                    <label class="label py-1 pb-2.5">
                        <span class="label-text font-bold uppercase tracking-wider text-xs text-base-content/70">Choisissez votre mode de paiement</span>
                    </label>
                    <div class="flex flex-col gap-2.5">
                        <% providers.forEach(function(provider, index) { %>
                            <label class="flex items-center gap-3.5 p-3.5 sm:p-4 border-2 border-base-300 rounded-2xl cursor-pointer hover:border-primary/60 hover:bg-base-200/40 transition-all bg-base-100 active:scale-[0.99] group">
                                <input type="radio" name="provider" value="<%= provider.id %>" class="radio radio-primary radio-sm sm:radio-md" <%= index === 0 ? 'checked' : '' %> required />
                                
                                <div class="flex-1 flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <% if (provider.id === 'lomopay' || provider.id === 'chariow' || provider.id === 'ikeepay') { %>
                                            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold text-lg shrink-0">
                                                📱
                                            </div>
                                            <div>
                                                <div class="font-bold text-base-content text-sm sm:text-base">Mobile Money</div>
                                                <div class="text-xs text-base-content/60 mt-0.5">Wave, Orange Money, MTN MoMo, Moov</div>
                                            </div>
                                        <% } else if (provider.id === 'stripe' || provider.id === 'whop') { %>
                                            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center font-bold text-lg shrink-0">
                                                💳
                                            </div>
                                            <div>
                                                <div class="font-bold text-base-content text-sm sm:text-base">Carte Bancaire</div>
                                                <div class="text-xs text-base-content/60 mt-0.5">Visa, Mastercard, Apple Pay, Google Pay</div>
                                            </div>
                                        <% } else { %>
                                            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-lg shrink-0">
                                                ⚡
                                            </div>
                                            <div>
                                                <div class="font-bold text-base-content text-sm sm:text-base"><%= provider.name %></div>
                                                <div class="text-xs text-base-content/60 mt-0.5">Paiement sécurisé</div>
                                            </div>
                                        <% } %>
                                    </div>

                                    <div class="text-xs font-bold text-base-content/40 uppercase tracking-wider group-hover:text-primary transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                    </div>
                                </div>
                            </label>
                        <% }); %>
                    </div>
                </div>

                <div class="flex flex-col gap-2.5">
                    <button type="submit" id="submit-btn" class="btn btn-primary btn-block shadow-lg font-bold text-base min-h-[48px] h-12 rounded-xl">
                        <span>Payer <%= Number(session.amount).toLocaleString() %> <%= session.currency %></span>
                    </button>
                    
                    <% if (session.cancelUrl) { %>
                        <a href="<%= session.cancelUrl %>" class="btn btn-ghost btn-sm btn-block font-medium text-xs text-base-content/60 hover:text-error">
                            Annuler et retourner au site
                        </a>
                    <% } %>
                </div>
            </form>

        </div>
        
        <!-- Footer security badge -->
        <div class="bg-base-200/60 p-3.5 border-t border-base-300 text-center text-[11px] text-base-content/50 flex items-center justify-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Transactions protégées par cryptage SSL 256-bit</span>
        </div>
    </div>

    <!-- Embedded In-Page Payment Frame (Le client reste toujours sur checkout.relyx.xyz) -->
    <div id="embedded-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex flex-col items-center justify-center p-2 sm:p-4 hidden">
        <div class="w-full max-w-lg h-[92vh] max-h-[800px] bg-base-100 rounded-3xl overflow-hidden shadow-2xl flex flex-col relative border border-base-300">
            <!-- Header Marque Blanche -->
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-base-300 bg-base-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-primary text-primary-content font-black text-xs flex items-center justify-center">
                        <%= (storeName && storeName.length > 0) ? storeName.charAt(0).toUpperCase() : 'S' %>
                    </div>
                    <div>
                        <span class="font-bold text-sm text-base-content block leading-tight"><%= storeName || 'Paiement Sécurisé' %></span>
                        <span class="text-[10px] text-success font-semibold flex items-center gap-1">🔒 SSL Sécurisé</span>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <a id="external-link-btn" href="#" target="_blank" class="btn btn-xs btn-ghost text-xs text-base-content/60" title="Ouvrir dans un nouvel onglet">
                        ↗ Nouvel onglet
                    </a>
                    <button type="button" id="close-modal-btn" class="btn btn-sm btn-circle btn-ghost text-base-content/70">✕</button>
                </div>
            </div>
            
            <!-- Loading Indicator -->
            <div id="iframe-loading" class="absolute inset-0 top-14 bg-base-100 flex flex-col items-center justify-center gap-3 z-10">
                <span class="loading loading-spinner loading-lg text-primary"></span>
                <p class="text-xs font-semibold text-base-content/60">Connexion sécurisée en cours...</p>
            </div>

            <!-- Iframe Seamless -->
            <iframe id="payment-iframe" src="" class="w-full flex-1 border-0" allow="payment *; clipboard-write *" onload="document.getElementById('iframe-loading').classList.add('hidden');"></iframe>
        </div>
    </div>

    <script>
        const form = document.getElementById('payment-form');
        const submitBtn = document.getElementById('submit-btn');
        const errorAlert = document.getElementById('error-alert');
        const errorText = document.getElementById('error-text');
        
        const embeddedModal = document.getElementById('embedded-modal');
        const paymentIframe = document.getElementById('payment-iframe');
        const iframeLoading = document.getElementById('iframe-loading');
        const closeModalBtn = document.getElementById('close-modal-btn');
        const externalLinkBtn = document.getElementById('external-link-btn');

        function showError(msg) {
            errorText.textContent = msg;
            errorAlert.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Réessayer</span>';
        }

        closeModalBtn.addEventListener('click', () => {
            embeddedModal.classList.add('hidden');
            paymentIframe.src = '';
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Payer <%= Number(session.amount).toLocaleString() %> <%= session.currency %></span>';
        });

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorAlert.classList.add('hidden');

            const providerInput = document.querySelector('input[name="provider"]:checked');
            if (!providerInput) return;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Initialisation sécurisée...';

            try {
                const response = await fetch('/checkout/pay', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        token: document.querySelector('input[name="token"]').value,
                        provider: providerInput.value
                    })
                });

                const data = await response.json();

                if (data.checkoutUrl) {
                    // Option Encastrée : Le client ne quitte pas checkout.relyx.xyz
                    externalLinkBtn.href = data.checkoutUrl;
                    iframeLoading.classList.remove('hidden');
                    paymentIframe.src = data.checkoutUrl;
                    embeddedModal.classList.remove('hidden');
                    
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<span>Paiement en cours...</span>';
                } else {
                    showError(data.error || 'Impossible d’initialiser le paiement.');
                }
            } catch (err) {
                showError('Erreur de connexion. Veuillez vérifier votre réseau.');
            }
        });
    </script>
</body>
</html>
