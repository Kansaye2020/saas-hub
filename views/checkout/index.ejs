<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Paiement Sécurisé | <%= storeName %></title>
    
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root, [data-theme="light"] {
            color-scheme: light;
            --color-base-100: oklch(100% 0 0);
            --color-base-200: oklch(98% 0 0);
            --color-base-300: oklch(95% 0 0);
            --color-base-content: oklch(21% 0.006 285.885);
            --color-primary: oklch(45% 0.24 277.023);
            --color-primary-content: oklch(93% 0.034 272.788);
            --color-secondary: oklch(65% 0.241 354.308);
            --color-secondary-content: oklch(94% 0.028 342.258);
            --color-accent: oklch(77% 0.152 181.912);
            --color-accent-content: oklch(38% 0.063 188.416);
            --color-neutral: oklch(14% 0.005 285.823);
            --color-neutral-content: oklch(92% 0.004 286.32);
            --color-info: oklch(74% 0.16 232.661);
            --color-info-content: oklch(29% 0.066 243.157);
            --color-success: oklch(76% 0.177 163.223);
            --color-success-content: oklch(37% 0.077 168.94);
            --color-warning: oklch(82% 0.189 84.429);
            --color-warning-content: oklch(41% 0.112 45.904);
            --color-error: oklch(71% 0.194 13.428);
            --color-error-content: oklch(27% 0.105 12.094);
            --radius-selector: 0.75rem;
            --radius-field: 0.5rem;
            --radius-box: 0.75rem;
            --size-selector: 0.25rem;
            --size-field: 0.25rem;
            --border: 1px;
            --depth: 1;
            --noise: 0;

            /* DaisyUI 4 properties */
            --p: 45% 0.24 277.023;
            --pc: 93% 0.034 272.788;
            --s: 65% 0.241 354.308;
            --sc: 94% 0.028 342.258;
            --a: 77% 0.152 181.912;
            --ac: 38% 0.063 188.416;
            --n: 14% 0.005 285.823;
            --nc: 92% 0.004 286.32;
            --b1: 100% 0 0;
            --b2: 98% 0 0;
            --b3: 95% 0 0;
            --bc: 21% 0.006 285.885;
            --in: 74% 0.16 232.661;
            --inc: 29% 0.066 243.157;
            --su: 76% 0.177 163.223;
            --suc: 37% 0.077 168.94;
            --wa: 82% 0.189 84.429;
            --wac: 41% 0.112 45.904;
            --er: 71% 0.194 13.428;
            --erc: 27% 0.105 12.094;
            --rounded-box: 0.75rem;
            --rounded-btn: 0.5rem;
            --rounded-badge: 0.5rem;
            --tab-radius: 0.5rem;
        }
        body { font-family: 'Inter', sans-serif; }
        /* Touch optimization */
        input, button, label {
            -webkit-tap-highlight-color: transparent;
        }
    </style>
</head>
<body class="<%= mode === 'widget' ? 'bg-transparent' : 'bg-base-200' %> min-h-screen flex items-center justify-center p-3 sm:p-6 antialiased">
    
    <div class="w-full max-w-md <%= mode === 'widget' ? 'bg-base-100' : 'bg-base-100 shadow-xl' %> rounded-2xl border border-base-300 overflow-hidden my-auto">
        <div class="p-5 sm:p-8">
            
            <!-- Store Header -->
            <div class="text-center mb-5 sm:mb-6">
                <div class="avatar placeholder mb-2.5">
                    <div class="bg-primary text-primary-content rounded-2xl w-12 h-12 sm:w-14 sm:h-14 shadow-sm flex items-center justify-center font-black text-lg sm:text-xl">
                        <span><%= (storeName && storeName.length > 0) ? storeName.charAt(0).toUpperCase() : 'S' %></span>
                    </div>
                </div>
                <h1 class="text-xl sm:text-2xl font-black text-base-content tracking-tight"><%= storeName || 'Boutique' %></h1>
                <div class="flex items-center justify-center gap-1.5 text-xs text-base-content/60 mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span>Paiement sécurisé et crypté</span>
                </div>
            </div>

            <!-- Amount Block -->
            <div class="bg-base-200 rounded-xl p-4 sm:p-5 text-center mb-6 border border-base-300">
                <p class="text-[11px] font-bold uppercase tracking-wider text-base-content/60 mb-1">Montant total</p>
                <div class="text-3xl sm:text-4xl font-black text-base-content tracking-tight">
                    <%= session.amount.toLocaleString() %> <span class="text-lg sm:text-xl font-bold opacity-70"><%= session.currency %></span>
                </div>
                <% if (session.description) { %>
                    <div class="badge badge-outline mt-2 text-xs font-semibold text-base-content/80 max-w-full truncate px-3 py-1">
                        <%= session.description %>
                    </div>
                <% } %>
            </div>

            <!-- Payment Form -->
            <form id="payment-form" action="/checkout/pay" method="POST">
                <input type="hidden" name="token" value="<%= session.token %>">
                
                <div class="form-control mb-6">
                    <label class="label py-1 pb-2">
                        <span class="label-text font-bold uppercase tracking-wider text-xs text-base-content/70">Sélectionnez votre moyen de paiement</span>
                    </label>
                    <div class="flex flex-col gap-2.5">
                        <% providers.forEach(function(provider, index) { %>
                            <label class="flex items-center gap-3.5 p-3.5 sm:p-4 border-2 border-base-300 rounded-xl cursor-pointer hover:border-primary/50 hover:bg-base-200/40 transition-all bg-base-100 active:scale-[0.99]">
                                <input type="radio" name="provider" value="<%= provider.id %>" class="radio radio-primary radio-sm sm:radio-md" <%= index === 0 ? 'checked' : '' %> required />
                                
                                <div class="flex-1 flex items-center justify-between">
                                    <div>
                                        <% if (provider.id === 'lomopay' || provider.id === 'chariow' || provider.id === 'ikeepay') { %>
                                            <div class="font-bold text-base-content text-sm sm:text-base">Mobile Money</div>
                                            <div class="text-xs text-base-content/60 mt-0.5">Wave, Orange Money, MTN, Moov</div>
                                        <% } else if (provider.id === 'stripe' || provider.id === 'whop') { %>
                                            <div class="font-bold text-base-content text-sm sm:text-base">Carte Bancaire</div>
                                            <div class="text-xs text-base-content/60 mt-0.5">Visa, Mastercard, Apple Pay</div>
                                        <% } else { %>
                                            <div class="font-bold text-base-content text-sm sm:text-base"><%= provider.name %></div>
                                        <% } %>
                                    </div>

                                    <div class="text-xs font-bold opacity-40 uppercase tracking-wider">
                                        <% if (provider.id === 'lomopay') { %>📱 MOMO<% } %>
                                        <% if (provider.id === 'stripe' || provider.id === 'whop') { %>💳 CB<% } %>
                                    </div>
                                </div>
                            </label>
                        <% }); %>
                    </div>
                </div>

                <div class="flex flex-col gap-2.5">
                    <button type="submit" id="submit-btn" class="btn btn-primary btn-block shadow-md font-bold text-base min-h-[48px] h-12">
                        Payer <%= session.amount.toLocaleString() %> <%= session.currency %>
                    </button>
                    
                    <% if (session.cancelUrl) { %>
                        <a href="<%= session.cancelUrl %>" class="btn btn-ghost btn-sm btn-block font-medium text-xs text-base-content/60 hover:text-error">
                            Annuler et retourner à la boutique
                        </a>
                    <% } %>
                </div>
            </form>

        </div>
        
        <!-- Footer security badge -->
        <div class="bg-base-200/60 p-3 border-t border-base-300 text-center text-[11px] text-base-content/50 flex items-center justify-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Transactions protégées par cryptage SSL 256-bit</span>
        </div>
    </div>

    <script>
        const form = document.getElementById('payment-form');
        const submitBtn = document.getElementById('submit-btn');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const providerInput = document.querySelector('input[name="provider"]:checked');
            if (!providerInput) return;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Traitement en cours...';

            try {
                const response = await fetch('/checkout/pay', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        token: document.querySelector('input[name="token"]').value,
                        provider: providerInput.value
                    })
                });

                const data = await response.json();

                if (data.checkoutUrl) {
                    if (window.self !== window.top) {
                        window.top.location.href = data.checkoutUrl;
                    } else {
                        window.location.href = data.checkoutUrl;
                    }
                } else {
                    alert(data.error || 'Erreur lors du paiement');
                    submitBtn.disabled = false;
                    submitBtn.innerText = 'Réessayer';
                }
            } catch (err) {
                alert('Erreur réseau. Veuillez vérifier votre connexion.');
                submitBtn.disabled = false;
                submitBtn.innerText = 'Réessayer';
            }
        });
    </script>
</body>
</html>
