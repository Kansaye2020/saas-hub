<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= currentApp.name %> | Dashboard SaaS Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        input, button, a, select { -webkit-tap-highlight-color: transparent; }
        .dot-pulse { position: relative; }
        .dot-pulse::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            border-radius: 9999px;
            background: currentColor;
            opacity: 0.75;
            animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
        }
        @keyframes ping {
            75%, 100% { transform: scale(2); opacity: 0; }
        }
    </style>
</head>
<body class="bg-base-200 min-h-screen antialiased">
    
    <!-- Navbar Responsive -->
    <div class="navbar bg-base-100 shadow-sm border-b border-base-300 sticky top-0 z-30 px-3 sm:px-6">
        <div class="flex-1 flex items-center gap-2">
            <a href="/admin/apps" class="btn btn-ghost px-2 text-base sm:text-lg font-black tracking-tight text-primary flex items-center gap-1.5">
                <span>SaaS Hub</span>
            </a>
            
            <!-- Sélecteur de Site (Switcher rapide) -->
            <div class="dropdown">
                <div tabindex="0" role="button" class="btn btn-xs sm:btn-sm btn-outline border-base-300 font-bold gap-1.5 sm:gap-2 bg-base-200 rounded-lg sm:rounded-xl">
                    <span class="w-2 h-2 rounded-full bg-success"></span>
                    <span class="text-base-content max-w-[90px] sm:max-w-[150px] truncate text-xs sm:text-sm"><%= currentApp.name %></span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </div>
                <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-2xl bg-base-100 rounded-2xl w-64 sm:w-72 border border-base-300 mt-2">
                    <li class="menu-title text-xs uppercase font-bold text-base-content/60 px-3 py-1">Changer de site</li>
                    <% allApps.forEach(function(app) { %>
                        <li>
                            <a href="/admin/app/<%= app.id %>" class="<%= app.id === currentApp.id ? 'active font-bold' : '' %> flex items-center justify-between py-2 rounded-xl">
                                <span class="truncate"><%= app.name %></span>
                                <span class="badge badge-xs font-mono"><%= app.id %></span>
                            </a>
                        </li>
                    <% }); %>
                    <div class="divider my-1"></div>
                    <li>
                        <a href="/admin/apps" class="text-primary font-bold py-2 rounded-xl">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                            Gérer tous les sites
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="flex-none flex items-center gap-1">
            <a href="/admin/apps" class="btn btn-ghost btn-sm text-xs sm:text-sm font-semibold hidden sm:inline-flex">
                Tous les sites
            </a>
            <a href="/admin/logout" class="btn btn-ghost btn-sm text-error font-bold text-xs sm:text-sm hover:bg-error/10">
                Déconnexion
            </a>
        </div>
    </div>

    <div class="max-w-7xl mx-auto p-3 sm:p-6 lg:p-8">
        
        <!-- Header du Site Responsive -->
        <div class="bg-base-100 rounded-2xl p-4 sm:p-6 shadow-sm border border-base-300 mb-5 sm:mb-6 flex flex-col md:flex-row md:items-center justify-between gap-3 sm:gap-4">
            <div>
                <div class="flex items-center gap-2 sm:gap-3">
                    <a href="/admin/apps" class="btn btn-sm btn-ghost btn-circle" title="Retour à la liste des sites">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                    </a>
                    <h1 class="text-xl sm:text-3xl font-black text-base-content tracking-tight truncate"><%= currentApp.name %></h1>
                    <span class="badge badge-primary font-mono text-[10px] sm:text-xs">ID: <%= currentApp.id %></span>
                </div>
                <p class="text-xs sm:text-sm text-base-content/70 mt-1 pl-9 sm:pl-11">Tableau de bord dédié et processeurs de paiement indépendants.</p>
            </div>
            
            <div class="flex items-center gap-2 pl-9 sm:pl-0">
                <a href="/admin/apps" class="btn btn-sm btn-outline gap-1 font-bold rounded-xl text-xs sm:text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
                    Sites
                </a>
                <button class="btn btn-sm btn-primary font-bold rounded-xl text-xs sm:text-sm shadow-sm" onclick="openEditAppModal()">
                    Modifier le site
                </button>
            </div>
        </div>

        <!-- Onglets de Navigation Responsive -->
        <div class="bg-base-100 p-1 rounded-xl border border-base-300 shadow-sm mb-6 flex overflow-x-auto whitespace-nowrap gap-1 max-w-full">
            <a href="/admin/app/<%= currentApp.id %>?tab=dashboard" 
               class="flex-1 text-center py-2 px-3 sm:px-4 rounded-lg text-xs sm:text-sm font-bold transition-all shrink-0 <%= activeTab === 'dashboard' ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/70 hover:text-base-content hover:bg-base-200' %>">
                Tableau de bord
            </a>
            <a href="/admin/app/<%= currentApp.id %>?tab=processors" 
               class="flex-1 flex items-center justify-center gap-1.5 text-center py-2 px-3 sm:px-4 rounded-lg text-xs sm:text-sm font-bold transition-all shrink-0 <%= activeTab === 'processors' ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/70 hover:text-base-content hover:bg-base-200' %>">
                <span>Processeurs</span>
                <span class="badge badge-xs sm:badge-sm font-mono font-bold <%= activeTab === 'processors' ? 'bg-primary-content/20 text-primary-content border-none' : 'badge-neutral' %>">
                    <%= configuredProviders.length %>
                </span>
            </a>
            <a href="/admin/app/<%= currentApp.id %>?tab=settings" 
               class="flex-1 text-center py-2 px-3 sm:px-4 rounded-lg text-xs sm:text-sm font-bold transition-all shrink-0 <%= activeTab === 'settings' ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/70 hover:text-base-content hover:bg-base-200' %>">
                Clés API & Webhook
            </a>
        </div>

        <!-- CONTENU ONGLET 1 : DASHBOARD -->
        <% if (activeTab === 'dashboard') { %>
            
            <!-- Cartes de Statistiques du Site -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6 mb-6 sm:mb-8">
                <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-4 sm:p-6">
                    <div class="stat-figure text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-7 h-7 sm:w-9 sm:h-9 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
                    </div>
                    <div class="stat-title text-[11px] font-bold uppercase text-base-content/60">Revenu de ce site</div>
                    <div class="stat-value text-xl sm:text-2xl font-black text-primary mt-1"><%= totalRevenue.toLocaleString() %> FCFA</div>
                    <div class="stat-desc text-xs mt-1">Généré par <%= currentApp.name %></div>
                </div>
                
                <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-4 sm:p-6">
                    <div class="stat-figure text-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-7 h-7 sm:w-9 sm:h-9 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <div class="stat-title text-[11px] font-bold uppercase text-base-content/60">Transactions Réussies</div>
                    <div class="stat-value text-xl sm:text-2xl font-black text-secondary mt-1"><%= locals.successfulTransactions ?? locals.totalTransactions ?? 0 %></div>
                    <div class="stat-desc text-xs mt-1">Paiements validés</div>
                </div>

                <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-4 sm:p-6">
                    <div class="stat-figure text-accent">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-7 h-7 sm:w-9 sm:h-9 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    </div>
                    <div class="stat-title text-[11px] font-bold uppercase text-base-content/60">Passerelles Actives</div>
                    <div class="stat-value text-xl sm:text-2xl font-black text-accent mt-1"><%= configuredProviders.filter(p => p.isActive).length %></div>
                    <div class="stat-desc text-xs mt-1">Sur <%= configuredProviders.length %> configuré(s)</div>
                </div>
            </div>

            <!-- Historique des Transactions Récentes -->
            <div class="card bg-base-100 shadow-sm border border-base-300 rounded-2xl overflow-hidden mb-8">
                <div class="card-body p-4 sm:p-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                        <div>
                            <h2 class="card-title text-lg sm:text-xl font-bold text-base-content">Dernières transactions de ce site</h2>
                            <p class="text-xs text-base-content/60">Historique des 25 derniers paiements sur <%= currentApp.name %></p>
                        </div>
                    </div>

                    <% if (recentTransactions.length === 0) { %>
                        <div class="text-center py-10 bg-base-200 rounded-xl">
                            <p class="text-base-content/50 font-medium text-sm">Aucune transaction enregistrée pour ce site.</p>
                        </div>
                    <% } else { %>
                        <div class="overflow-x-auto -mx-4 sm:mx-0">
                            <table class="table table-sm sm:table-md w-full">
                                <thead>
                                    <tr class="text-xs uppercase text-base-content/60 border-b border-base-200">
                                        <th>Date</th>
                                        <th>Référence</th>
                                        <th>Montant</th>
                                        <th>Passerelle</th>
                                        <th>Client</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentTransactions.forEach(function(tx) { %>
                                        <tr class="hover:bg-base-200/50">
                                            <td class="text-xs text-base-content/70 whitespace-nowrap"><%= new Date(tx.createdAt).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                                            <td class="font-mono text-xs font-bold"><%= tx.orderId || tx.id.substring(0, 10) %></td>
                                            <td class="font-bold text-sm text-base-content"><%= tx.amount.toLocaleString() %> <%= tx.currency %></td>
                                            <td>
                                                <span class="badge badge-sm badge-neutral capitalize font-semibold"><%= tx.provider %></span>
                                            </td>
                                            <td class="text-xs text-base-content/70"><%= tx.customerEmail || '-' %></td>
                                            <td>
                                                <% if (tx.status === 'succeeded') { %>
                                                    <span class="badge badge-sm badge-success text-white font-bold">Réussi</span>
                                                <% } else if (tx.status === 'pending') { %>
                                                    <span class="badge badge-sm badge-warning font-bold">En attente</span>
                                                <% } else { %>
                                                    <span class="badge badge-sm badge-error text-white font-bold"><%= tx.status %></span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>

        <!-- CONTENU ONGLET 2 : PROCESSEURS DE PAIEMENT DU SITE -->
        <% } else if (activeTab === 'processors') { %>

            <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <h2 class="text-xl sm:text-2xl font-black text-base-content">Processeurs de <%= currentApp.name %></h2>
                    <p class="text-xs sm:text-sm text-base-content/70 mt-0.5">Configurez et activez les passerelles de paiement propres à ce site.</p>
                </div>
                <button class="btn btn-primary shadow-sm gap-2 min-h-[44px] h-11 w-full sm:w-auto font-bold rounded-xl" onclick="openAddProcessorModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Ajouter un processeur
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-8">
                <% if (configuredProviders.length === 0) { %>
                    <div class="col-span-full card bg-base-100 shadow-sm border border-dashed border-base-300 p-8 sm:p-12 text-center rounded-2xl">
                        <div class="w-16 h-16 rounded-full bg-primary/10 text-primary mx-auto flex items-center justify-center mb-3 text-2xl">
                            ⚡
                        </div>
                        <h3 class="font-bold text-lg text-base-content">Aucun processeur configuré</h3>
                        <p class="text-xs sm:text-sm text-base-content/60 max-w-md mx-auto mt-1 mb-5">Ajoutez une passerelle de paiement (LomoPay, iKeePay, Stripe, Whop, Chariow) pour activer les encaissements sur <%= currentApp.name %>.</p>
                        <div>
                            <button class="btn btn-primary btn-sm font-bold rounded-xl shadow-sm" onclick="openAddProcessorModal()">
                                + Ajouter un processeur
                            </button>
                        </div>
                    </div>
                <% } else { %>
                    <% configuredProviders.forEach(function(prov) { %>
                        <div class="card bg-base-100 shadow-sm border border-base-300 rounded-2xl">
                            <div class="card-body p-4 sm:p-6">
                                <div class="flex justify-between items-start mb-3">
                                    <div>
                                        <h3 class="card-title text-lg sm:text-xl font-bold"><%= prov.name || prov.meta?.name || prov.providerId %></h3>
                                        <p class="text-xs text-base-content/60"><%= prov.tagline || prov.meta?.tagline || 'Processeur de paiement' %></p>
                                    </div>
                                    
                                    <div class="m-0 flex items-center">
                                        <label class="cursor-pointer flex items-center gap-2 select-none bg-base-200 hover:bg-base-300/70 px-3 py-1.5 rounded-full border border-base-300 transition-all shadow-xs" title="Cliquer pour activer/désactiver ce processeur">
                                            <span id="status-text-<%= prov.providerId %>" class="text-[11px] sm:text-xs font-black uppercase tracking-wider <%= prov.isActive ? 'text-success' : 'text-base-content/40' %>">
                                                <%= prov.isActive ? 'Actif' : 'Inactif' %>
                                            </span>
                                            <input 
                                                type="checkbox" 
                                                id="toggle-<%= prov.providerId %>"
                                                class="toggle toggle-success toggle-sm cursor-pointer transition-all duration-200 ease-in-out" 
                                                <%= prov.isActive ? 'checked' : '' %> 
                                                onchange="toggleProcessorAjax('<%= currentApp.id %>', '<%= prov.providerId %>', this)" 
                                            />
                                        </label>
                                    </div>
                                </div>

                                <div class="bg-base-200 p-3 rounded-xl border border-base-300 text-xs font-mono mb-4 space-y-1.5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-base-content/60"><%= prov.publicKeyLabel || prov.meta?.publicKeyLabel || 'Clé Publique' %>:</span>
                                        <span class="font-bold truncate max-w-[160px]"><%= prov.publicKey ? (prov.publicKey.substring(0, 8) + '••••••••') : 'Non requise' %></span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-base-content/60"><%= prov.secretKeyLabel || prov.meta?.secretKeyLabel || 'Clé Secrète' %>:</span>
                                        <span class="font-bold truncate max-w-[160px]"><%= prov.maskedSecretKey || (prov.secretKey ? '••••••••' : 'Non configurée') %></span>
                                    </div>
                                </div>

                                <div class="card-actions justify-end gap-2 pt-2 border-t border-base-200">
                                    <form method="POST" action="/admin/app/<%= currentApp.id %>/provider/delete" onsubmit="return confirm('Retirer définitivement ce processeur pour ce site ?')" class="m-0">
                                        <input type="hidden" name="providerId" value="<%= prov.providerId %>">
                                        <button type="submit" class="btn btn-ghost btn-sm text-error font-bold rounded-lg hover:bg-error/10">Supprimer</button>
                                    </form>
                                    <button type="button" class="btn btn-outline btn-primary btn-sm font-bold rounded-lg" onclick="openEditProcessorModal('<%= prov.providerId %>', '<%= (prov.publicKey || '').replace(/'/g, "\\'") %>', '', '<%= (prov.extraConfig || '').replace(/'/g, "\\'") %>', <%= prov.isActive ? 1 : 0 %>)">
                                        Modifier les clés
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>

        <!-- CONTENU ONGLET 3 : PARAMÈTRES & CLÉS API DU SITE -->
        <% } else if (activeTab === 'settings') { %>

            <div class="bg-base-100 rounded-2xl p-4 sm:p-8 shadow-sm border border-base-300 max-w-3xl mb-8">
                <h2 class="text-xl sm:text-2xl font-black text-base-content mb-1">Paramètres & Clés API de <%= currentApp.name %></h2>
                <p class="text-xs sm:text-sm text-base-content/70 mb-6">Utilisez ces identifiants dans le code de votre SaaS pour initier des sessions de paiement.</p>

                <div class="space-y-4">
                    <div class="form-control w-full">
                        <label class="label py-1"><span class="label-text font-bold text-xs">Clé API du Site (X-Hub-Api-Key)</span></label>
                        <input type="text" value="<%= currentApp.apiKey %>" class="input input-bordered input-sm sm:input-md w-full bg-base-200 font-mono text-xs rounded-xl" readonly />
                    </div>

                    <div class="form-control w-full bg-primary/5 p-3 rounded-xl border border-primary/20">
                        <label class="label pt-0 py-1"><span class="label-text font-bold text-primary text-xs">🔗 URL de Redirection après paiement (Succès)</span></label>
                        <input type="text" value="<%= currentApp.returnUrl || 'Non définie' %>" class="input input-bordered input-sm sm:input-md w-full bg-base-200 font-mono text-xs rounded-xl" readonly />
                        <label class="label pb-0 py-0.5"><span class="label-text-alt text-base-content/60 text-[11px]">Le client y est redirigé une fois son paiement validé.</span></label>
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1"><span class="label-text font-bold text-xs">URL d'annulation (Cancel URL)</span></label>
                        <input type="text" value="<%= currentApp.cancelUrl || 'Non définie' %>" class="input input-bordered input-sm sm:input-md w-full bg-base-200 font-mono text-xs rounded-xl" readonly />
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1"><span class="label-text font-bold text-xs">URL du Webhook de votre site</span></label>
                        <input type="text" value="<%= currentApp.webhookUrl || 'Non définie' %>" class="input input-bordered input-sm sm:input-md w-full bg-base-200 font-mono text-xs rounded-xl" readonly />
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1"><span class="label-text font-bold text-xs">Secret Webhook (Signature HMAC-SHA256)</span></label>
                        <input type="text" value="<%= currentApp.webhookSecret %>" class="input input-bordered input-sm sm:input-md w-full bg-base-200 font-mono text-xs rounded-xl" readonly />
                    </div>
                </div>

                <div class="divider my-6"></div>

                <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
                    <button class="btn btn-primary font-bold w-full sm:w-auto rounded-xl shadow-sm" onclick="openEditAppModal()">
                        Modifier les paramètres de ce site
                    </button>

                    <form method="POST" action="/admin/apps/delete" onsubmit="return confirm('Supprimer définitivement ce site et ses données ?')" class="w-full sm:w-auto">
                        <input type="hidden" name="appId" value="<%= currentApp.id %>">
                        <button type="submit" class="btn btn-ghost text-error font-bold hover:bg-error/10 w-full sm:w-auto rounded-xl">
                            Supprimer ce site
                        </button>
                    </form>
                </div>
            </div>

        <% } %>

    </div>

    <!-- Modal Ajouter / Modifier Processeur (Mobile Responsive) -->
    <dialog id="processor_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box w-full sm:max-w-xl p-4 sm:p-6 rounded-t-3xl sm:rounded-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-extrabold text-lg sm:text-xl text-base-content" id="proc-modal-title">Ajouter un processeur</h3>
                <button type="button" class="btn btn-sm btn-circle btn-ghost" onclick="document.getElementById('processor_modal').close()">✕</button>
            </div>

            <form method="POST" action="/admin/app/<%= currentApp.id %>/provider" id="processor-form">
                <input type="hidden" name="isEdit" id="proc-form-isEdit" value="0">
                <input type="hidden" name="providerId" id="proc-form-providerId-input" value="">
                
                <!-- Vue Ajout : Sélecteur déroulant -->
                <div class="form-control w-full mb-3.5" id="proc-dropdown-wrapper">
                    <label class="label py-1"><span class="label-text font-bold text-xs">Choisir la passerelle</span></label>
                    <select id="proc-form-select-providerId" class="select select-bordered select-sm sm:select-md w-full font-medium rounded-xl text-xs sm:text-sm" onchange="onSelectProviderDropdown(this.value)">
                        <option value="" disabled selected>-- Sélectionnez un processeur --</option>
                        <% allAvailableProviders.forEach(function(prov) { %>
                            <option value="<%= prov.id %>">
                                <%= prov.name %> — <%= prov.tagline %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <!-- Vue Modification : Badge / Nom du processeur -->
                <div class="form-control w-full mb-3.5 hidden" id="proc-edit-badge-wrapper">
                    <label class="label py-1"><span class="label-text font-bold text-xs">Passerelle de paiement</span></label>
                    <div class="bg-base-200 border border-base-300 p-3 rounded-xl flex items-center justify-between">
                        <span class="font-bold text-sm text-base-content" id="proc-edit-provider-name">LomoPay</span>
                        <span class="badge badge-primary font-mono text-xs uppercase" id="proc-edit-provider-id">lomopay</span>
                    </div>
                </div>

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-bold text-xs" id="proc-label-publicKey">Clé Publique / ID</span></label>
                    <input type="text" name="publicKey" id="proc-form-publicKey" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" placeholder="pk_..." />
                </div>

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-bold text-xs" id="proc-label-secretKey">Clé Secrète / API Key</span></label>
                    <div class="relative">
                        <input type="password" name="secretKey" id="proc-form-secretKey" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl pr-10" placeholder="sk_..." autocomplete="new-password" />
                        <button type="button" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-base-content/40 hover:text-base-content text-sm" onclick="togglePasswordVisibility('proc-form-secretKey', this)">👁️</button>
                    </div>
                </div>

                <div class="form-control w-full mb-4" id="proc-wrapper-extraConfig">
                    <label class="label py-1"><span class="label-text font-bold text-xs" id="proc-label-extraConfig">Configuration supplémentaire</span></label>
                    <input type="text" name="extraConfig" id="proc-form-extraConfig" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" placeholder='{"webhookSecret": "..."}' />
                </div>

                <div class="bg-base-200 p-3.5 rounded-xl mb-5 border border-base-300 flex items-center justify-between">
                    <div>
                        <span class="text-xs sm:text-sm font-bold block text-base-content">Activer sur le site</span>
                        <span class="text-[11px] text-base-content/60">Visible au checkout de <%= currentApp.name %></span>
                    </div>
                    <input type="checkbox" name="isActive" id="proc-form-isActive" value="1" checked class="toggle toggle-success" />
                </div>

                <div class="modal-action flex gap-2">
                    <button type="button" class="btn btn-ghost flex-1 rounded-xl" onclick="document.getElementById('processor_modal').close()">Annuler</button>
                    <button type="submit" class="btn btn-primary flex-1 font-bold rounded-xl shadow-sm">Enregistrer</button>
                </div>
            </form>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <!-- Modal Modifier Site (Mobile Responsive) -->
    <dialog id="app_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box w-full sm:max-w-xl p-4 sm:p-6 rounded-t-3xl sm:rounded-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-extrabold text-lg sm:text-xl text-base-content">Modifier <%= currentApp.name %></h3>
                <button type="button" class="btn btn-sm btn-circle btn-ghost" onclick="document.getElementById('app_modal').close()">✕</button>
            </div>
            
            <form method="POST" action="/admin/apps">
                <input type="hidden" name="id" value="<%= currentApp.id %>">

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-bold text-xs">Nom Public du Site / SaaS</span></label>
                    <input type="text" name="name" value="<%= currentApp.name %>" class="input input-bordered input-sm sm:input-md w-full font-semibold text-xs sm:text-sm rounded-xl" required />
                </div>

                <div class="form-control w-full mb-3.5 bg-primary/5 p-3 rounded-xl border border-primary/20">
                    <label class="label pt-0 py-1"><span class="label-text font-bold text-primary text-xs">🔗 URL de Redirection de Succès (Return URL)</span></label>
                    <input type="url" name="returnUrl" value="<%= currentApp.returnUrl || '' %>" placeholder="https://monsite.com/commande-reussie" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" />
                </div>

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-semibold text-xs">URL d'annulation (Cancel URL)</span></label>
                    <input type="url" name="cancelUrl" value="<%= currentApp.cancelUrl || '' %>" placeholder="https://monsite.com/panier" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" />
                </div>

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-semibold text-xs">Clé API (X-Hub-Api-Key)</span></label>
                    <input type="text" name="apiKey" value="<%= currentApp.apiKey %>" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" />
                </div>

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-semibold text-xs">URL du Webhook de votre site</span></label>
                    <input type="text" name="webhookUrl" value="<%= currentApp.webhookUrl || '' %>" placeholder="https://monsite.com/api/webhook" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" />
                </div>

                <div class="form-control w-full mb-5">
                    <label class="label py-1"><span class="label-text font-semibold text-xs">Secret Webhook HMAC</span></label>
                    <input type="text" name="webhookSecret" value="<%= currentApp.webhookSecret %>" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" />
                </div>

                <div class="modal-action flex gap-2">
                    <button type="button" class="btn btn-ghost flex-1 rounded-xl" onclick="document.getElementById('app_modal').close()">Annuler</button>
                    <button type="submit" class="btn btn-primary flex-1 font-bold rounded-xl shadow-sm">Sauvegarder</button>
                </div>
            </form>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <script>
        const providersMeta = {
            <% allAvailableProviders.forEach(function(prov) { %>
                '<%= prov.id %>': {
                    name: '<%= prov.name %>',
                    pubLabel: '<%= prov.publicKeyLabel %>',
                    pubPlaceholder: '<%= prov.publicKeyPlaceholder %>',
                    secLabel: '<%= prov.secretKeyLabel %>',
                    secPlaceholder: '<%= prov.secretKeyPlaceholder %>',
                    hasExtra: <%= prov.hasExtraConfig %>,
                    extraLabel: '<%= prov.extraConfigLabel %>',
                    extraPlaceholder: '<%= prov.extraConfigPlaceholder %>'
                },
            <% }); %>
        };

        function onSelectProviderDropdown(providerId) {
            document.getElementById('proc-form-providerId-input').value = providerId;
            onProviderSelectChange(providerId);
        }

        function onProviderSelectChange(providerId) {
            const meta = providersMeta[providerId];
            if (!meta) return;

            document.getElementById('proc-label-publicKey').innerText = meta.pubLabel || 'Clé Publique / ID';
            document.getElementById('proc-form-publicKey').placeholder = meta.pubPlaceholder || 'pk_...';

            document.getElementById('proc-label-secretKey').innerText = meta.secLabel || 'Clé Secrète / API Key';
            document.getElementById('proc-form-secretKey').placeholder = meta.secPlaceholder || 'sk_...';

            const extraWrapper = document.getElementById('proc-wrapper-extraConfig');
            if (meta.hasExtra) {
                extraWrapper.style.display = 'block';
                document.getElementById('proc-label-extraConfig').innerText = meta.extraLabel || 'Configuration additionnelle';
                document.getElementById('proc-form-extraConfig').placeholder = meta.extraPlaceholder || '{"option": "valeur"}';
            } else {
                extraWrapper.style.display = 'none';
            }
        }

        function openAddProcessorModal() {
            document.getElementById('proc-modal-title').innerText = "Ajouter un processeur";
            document.getElementById('proc-form-isEdit').value = "0";

            document.getElementById('proc-dropdown-wrapper').classList.remove('hidden');
            document.getElementById('proc-edit-badge-wrapper').classList.add('hidden');

            const selectEl = document.getElementById('proc-form-select-providerId');
            selectEl.value = "";
            document.getElementById('proc-form-providerId-input').value = "";

            document.getElementById('proc-form-publicKey').value = "";
            document.getElementById('proc-form-secretKey').value = "";
            document.getElementById('proc-form-extraConfig').value = "";
            document.getElementById('proc-form-isActive').checked = true;

            const firstOption = selectEl.querySelector('option:not([disabled])');
            if (firstOption) {
                selectEl.value = firstOption.value;
                document.getElementById('proc-form-providerId-input').value = firstOption.value;
                onProviderSelectChange(firstOption.value);
            }
            
            document.getElementById('processor_modal').showModal();
        }

        function openEditProcessorModal(providerId, publicKey, secretKey, extraConfig, isActive) {
            document.getElementById('proc-modal-title').innerText = "Modifier le processeur";
            document.getElementById('proc-form-isEdit').value = "1";
            
            document.getElementById('proc-dropdown-wrapper').classList.add('hidden');
            document.getElementById('proc-edit-badge-wrapper').classList.remove('hidden');

            const meta = providersMeta[providerId] || {};
            document.getElementById('proc-edit-provider-name').innerText = meta.name || providerId.toUpperCase();
            document.getElementById('proc-edit-provider-id').innerText = providerId;
            document.getElementById('proc-form-providerId-input').value = providerId;

            onProviderSelectChange(providerId);

            document.getElementById('proc-form-publicKey').value = publicKey || '';
            document.getElementById('proc-form-secretKey').value = '';
            document.getElementById('proc-form-secretKey').placeholder = 'Laisser vide pour conserver la clé chiffrée actuelle';
            document.getElementById('proc-form-extraConfig').value = extraConfig || '';
            document.getElementById('proc-form-isActive').checked = (isActive === 1 || isActive === true || isActive === '1');

            document.getElementById('processor_modal').showModal();
        }

        function openEditAppModal() {
            document.getElementById('app_modal').showModal();
        }

        function togglePasswordVisibility(id, btn) {
            const el = document.getElementById(id);
            if (!el) return;
            if (el.type === 'password') {
                el.type = 'text';
                btn.innerText = '🙈';
            } else {
                el.type = 'password';
                btn.innerText = '👁️';
            }
        }

        /**
         * Système de notification Popup Toast flottant avec couleur dynamique et auto-destruction en 5s
         */
        function showToast(message, type = 'success', duration = 5000) {
            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.className = 'fixed top-5 right-5 z-[999999] flex flex-col gap-2.5 max-w-sm sm:max-w-md w-full pointer-events-none px-3 sm:px-0';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto transform transition-all duration-300 ease-out -translate-y-4 opacity-0 shadow-2xl rounded-2xl p-4 flex items-start gap-3 border text-white font-medium text-xs sm:text-sm';

            let bgClass = 'bg-emerald-600 border-emerald-400/40';
            let icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>';

            if (type === 'warning' || type === 'inactive' || type === 'disabled') {
                bgClass = 'bg-amber-600 border-amber-400/40';
                icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
            } else if (type === 'error' || type === 'danger') {
                bgClass = 'bg-rose-600 border-rose-400/40';
                icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>';
            } else if (type === 'info') {
                bgClass = 'bg-blue-600 border-blue-400/40';
                icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
            }

            toast.classList.add(...bgClass.split(' '));
            toast.innerHTML = `
                ${icon}
                <div class="flex-1 leading-snug font-semibold">${message}</div>
                <button type="button" class="btn btn-ghost btn-xs btn-circle text-white/80 hover:text-white" onclick="this.parentElement.remove()">✕</button>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('-translate-y-4', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2', 'scale-95');
                setTimeout(() => {
                    if (toast.parentElement) toast.remove();
                }, 300);
            }, duration);
        }

        /**
         * Bascule AJAX du switch avec mise à jour visuelle instantanée et popup toast dynamique
         */
        async function toggleProcessorAjax(appId, providerId, checkboxEl) {
            const isChecked = checkboxEl.checked;
            const statusTextEl = document.getElementById('status-text-' + providerId);
            
            // Mise à jour visuelle immédiate
            if (statusTextEl) {
                statusTextEl.innerText = isChecked ? 'Actif' : 'Inactif';
                if (isChecked) {
                    statusTextEl.classList.remove('text-base-content/40');
                    statusTextEl.classList.add('text-success');
                } else {
                    statusTextEl.classList.remove('text-success');
                    statusTextEl.classList.add('text-base-content/40');
                }
            }

            try {
                const response = await fetch(`/admin/app/${appId}/provider/toggle`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams({ providerId })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    if (data.isActive) {
                        showToast(data.message || `Processeur "${data.providerName || providerId}" activé avec succès.`, 'success', 5000);
                    } else {
                        showToast(data.message || `Processeur "${data.providerName || providerId}" désactivé.`, 'warning', 5000);
                    }
                } else {
                    throw new Error(data.error || "Erreur lors du changement de statut");
                }
            } catch (err) {
                // Annuler la bascule visuelle en cas d'erreur
                checkboxEl.checked = !isChecked;
                if (statusTextEl) {
                    statusTextEl.innerText = !isChecked ? 'Actif' : 'Inactif';
                    if (!isChecked) {
                        statusTextEl.classList.add('text-success');
                        statusTextEl.classList.remove('text-base-content/40');
                    } else {
                        statusTextEl.classList.remove('text-success');
                        statusTextEl.classList.add('text-base-content/40');
                    }
                }
                showToast(err.message || "Erreur de connexion lors du changement d'état.", 'error', 5000);
            }
        }

        // Affichage automatique des messages flash serveur en mode Popup Toast 5s
        document.addEventListener('DOMContentLoaded', () => {
            <% if (locals.successMessage) { %>
                const msg = "<%= successMessage.replace(/"/g, '\\"') %>";
                const isInactive = msg.toLowerCase().includes('inactif') || msg.toLowerCase().includes('désactivé');
                showToast(msg, isInactive ? 'warning' : 'success', 5000);
            <% } %>

            <% if (locals.errorMessage) { %>
                const errMsg = "<%= errorMessage.replace(/"/g, '\\"') %>";
                showToast(errMsg, 'error', 5000);
            <% } %>

            // Nettoyage propre de l'URL pour éviter la répétition du message au rafraîchissement
            if (window.location.search && (window.location.search.includes('success=') || window.location.search.includes('error='))) {
                const cleanUrl = window.location.pathname + window.location.search
                    .replace(/([&?])(success|error)=[^&]+(&|$)/g, '$1')
                    .replace(/&$/, '')
                    .replace(/\?$/, '');
                window.history.replaceState({}, document.title, cleanUrl || window.location.pathname);
            }
        });
</body>
</html>
