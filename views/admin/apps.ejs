<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mes Applications & Sites | SaaS Payment Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        input, button, a { -webkit-tap-highlight-color: transparent; }
    </style>
</head>
<body class="bg-base-200 min-h-screen antialiased">
    
    <!-- Navbar Responsive -->
    <div class="navbar bg-base-100 shadow-sm border-b border-base-300 sticky top-0 z-30 px-3 sm:px-6">
        <div class="flex-1">
            <a href="/admin/apps" class="btn btn-ghost px-2 text-base sm:text-lg font-black tracking-tight text-primary flex items-center gap-1.5 sm:gap-2">
                <span>SaaS Hub</span>
            </a>
        </div>
        <div class="flex-none flex items-center gap-1">
            <a href="/admin/apps" class="btn btn-ghost btn-sm text-primary font-bold text-xs sm:text-sm">
                Applications
            </a>
            <a href="/admin/logout" class="btn btn-ghost btn-sm text-error font-bold text-xs sm:text-sm hover:bg-error/10">
                Déconnexion
            </a>
        </div>
    </div>

    <div class="max-w-7xl mx-auto p-3 sm:p-6 lg:p-8">
        
        <!-- Header -->
        <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
            <div>
                <h1 class="text-2xl sm:text-3xl font-black text-base-content tracking-tight">Mes Sites & SaaS Enregistrés</h1>
                <p class="mt-1 text-xs sm:text-sm text-base-content/70">Sélectionnez un site pour ouvrir son tableau de bord et gérer ses paiements.</p>
            </div>
            <button class="btn btn-primary shadow-sm gap-2 min-h-[44px] h-11 w-full sm:w-auto font-bold rounded-xl" onclick="openAddAppModal()">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Ajouter un site / SaaS
            </button>
        </div>

        <!-- Global Summary Stats Bar (Mobile Optimized) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 mb-6 sm:mb-8">
            <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-4 sm:p-5">
                <div class="stat-figure text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-8 sm:w-8 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                </div>
                <div class="stat-title text-[11px] font-bold uppercase text-base-content/60">Sites Enregistrés</div>
                <div class="stat-value text-xl sm:text-2xl font-black mt-0.5"><%= locals.totalAppsCount || apps.length %></div>
                <div class="stat-desc text-xs mt-0.5">Espaces SaaS actifs</div>
            </div>

            <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-4 sm:p-5">
                <div class="stat-figure text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-8 sm:w-8 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div class="stat-title text-[11px] font-bold uppercase text-base-content/60">Revenu Global</div>
                <div class="stat-value text-xl sm:text-2xl font-black text-success mt-0.5"><%= (locals.totalGlobalRevenue || 0).toLocaleString() %> FCFA</div>
                <div class="stat-desc text-xs mt-0.5">Total cumulé encaissé</div>
            </div>

            <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-4 sm:p-5">
                <div class="stat-figure text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-8 sm:w-8 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                </div>
                <div class="stat-title text-[11px] font-bold uppercase text-base-content/60">Transactions Réussies</div>
                <div class="stat-value text-xl sm:text-2xl font-black text-secondary mt-0.5"><%= locals.totalGlobalTransactions || 0 %></div>
                <div class="stat-desc text-xs mt-0.5">Paiements validés</div>
            </div>
        </div>

        <% if (apps.length === 0) { %>
            <div class="text-center py-12 sm:py-16 bg-base-100 rounded-3xl shadow-sm border border-base-300 max-w-2xl mx-auto p-6 sm:p-8">
                <div class="w-16 h-16 sm:w-20 sm:h-20 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 sm:h-10 sm:w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-base-content">Aucun site configuré</h3>
                <p class="text-xs sm:text-sm text-base-content/60 mt-2 mb-6">Ajoutez votre premier site pour lui attribuer ses processeurs de paiement.</p>
                <button class="btn btn-primary btn-block sm:btn-wide shadow-md" onclick="openAddAppModal()">Ajouter mon premier site</button>
            </div>
        <% } %>

        <!-- App Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
            <% apps.forEach(function(app) { %>
                <div class="card bg-base-100 shadow-sm hover:shadow-xl transition-all border border-base-300 flex flex-col justify-between rounded-2xl">
                    <div class="card-body p-4 sm:p-6">
                        
                        <div class="flex justify-between items-start mb-3 sm:mb-4">
                            <div class="flex items-center gap-3 flex-1 min-w-0 pr-2">
                                <% if (app.logoUrl && app.logoUrl.trim()) { %>
                                    <img src="<%= app.logoUrl %>" alt="<%= app.name %>" class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl object-contain bg-base-200 border border-base-300 p-1 shrink-0" onerror="this.style.display='none'" />
                                <% } else { %>
                                    <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-primary/10 text-primary font-black flex items-center justify-center text-base sm:text-lg shrink-0">
                                        <%= app.name.charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                                <div class="min-w-0">
                                    <h2 class="card-title text-lg sm:text-xl font-black text-base-content truncate">
                                        <%= app.name %>
                                    </h2>
                                    <div class="badge badge-primary badge-outline text-[10px] sm:text-[11px] mt-0.5 font-mono">ID: <%= app.id %></div>
                                </div>
                            </div>
                            <div class="dropdown dropdown-end shrink-0">
                                <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-circle">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                                </div>
                                <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-2xl bg-base-100 rounded-box w-44 text-xs border border-base-300">
                                    <li><a href="/admin/app/<%= app.id %>?tab=settings" class="py-2">Modifier</a></li>
                                    <li>
                                        <form method="POST" action="/admin/apps/delete" onsubmit="return confirm('Supprimer ce site ?')" class="m-0 p-0">
                                            <input type="hidden" name="appId" value="<%= app.id %>">
                                            <button type="submit" class="text-error font-bold w-full text-left px-3 py-2">Supprimer</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Métriques du site -->
                        <div class="grid grid-cols-2 gap-2.5 sm:gap-3 mb-3 sm:mb-4">
                            <div class="bg-base-200 p-2.5 sm:p-3 rounded-xl border border-base-300">
                                <div class="text-[10px] uppercase font-bold text-base-content/60">Revenu site</div>
                                <div class="text-sm sm:text-base font-black text-primary mt-0.5 truncate"><%= (app.totalRevenue || 0).toLocaleString() %> FCFA</div>
                            </div>
                            <div class="bg-base-200 p-2.5 sm:p-3 rounded-xl border border-base-300">
                                <div class="text-[10px] uppercase font-bold text-base-content/60">Transactions</div>
                                <div class="text-sm sm:text-base font-black text-secondary mt-0.5"><%= app.transactionCount || 0 %></div>
                            </div>
                        </div>

                        <!-- Processeurs Actifs pour ce site -->
                        <div class="mb-3 sm:mb-4">
                            <div class="text-[10px] sm:text-[11px] font-bold text-base-content/60 uppercase mb-1.5 flex items-center justify-between">
                                <span>Passerelles actives</span>
                                <span class="badge badge-xs <%= app.activeProvidersCount > 0 ? 'badge-success text-white' : 'badge-ghost' %> font-mono font-bold"><%= app.activeProvidersCount %> actif(s)</span>
                            </div>
                            <div class="flex flex-wrap gap-1">
                                <% if (app.activeProviders && app.activeProviders.length > 0) { %>
                                    <% app.activeProviders.forEach(function(prov) { %>
                                        <span class="badge badge-xs sm:badge-sm badge-neutral capitalize font-semibold"><%= prov %></span>
                                    <% }); %>
                                <% } else { %>
                                    <span class="text-xs text-base-content/50 italic">Aucune passerelle</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Bouton d'accès au dashboard dédié -->
                        <div class="card-actions mt-3 pt-3 sm:mt-4 sm:pt-4 border-t border-base-200">
                            <a href="/admin/app/<%= app.id %>" class="btn btn-primary btn-block font-bold shadow-sm gap-2 min-h-[44px] h-11 text-xs sm:text-sm rounded-xl">
                                <span>📊 Ouvrir le Dashboard de ce site</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

    </div>

    <!-- Modal Ajouter un Site (Mobile Responsive) -->
    <dialog id="add_app_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box w-full sm:max-w-xl p-4 sm:p-6 rounded-t-3xl sm:rounded-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-extrabold text-lg sm:text-xl text-base-content">Ajouter un nouveau site / SaaS</h3>
                <button type="button" class="btn btn-sm btn-circle btn-ghost" onclick="document.getElementById('add_app_modal').close()">✕</button>
            </div>
            
            <form method="POST" action="/admin/apps">
                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-bold text-xs">Identifiant technique (ex: "verifsms", "monshop")</span></label>
                    <input type="text" name="id" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs sm:text-sm rounded-xl" placeholder="ex: mon-saas-1" required />
                </div>
                
                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-bold text-xs">Nom Public du Site (affiché au client au checkout)</span></label>
                    <input type="text" name="name" class="input input-bordered input-sm sm:input-md w-full font-semibold text-xs sm:text-sm rounded-xl" placeholder="ex: Ma Boutique Officielle" required />
                </div>

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-bold text-xs">🖼️ URL du Logo de l'entreprise (Optionnel)</span></label>
                    <input type="url" name="logoUrl" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" placeholder="https://monsite.com/logo.png" />
                    <label class="label pb-0 py-0.5"><span class="label-text-alt text-base-content/60 text-[11px]">Affiché en haut du tunnel de paiement et sur le dashboard.</span></label>
                </div>

                <div class="form-control w-full mb-3.5 bg-primary/5 p-3 rounded-xl border border-primary/20">
                    <label class="label pt-0 py-1"><span class="label-text font-bold text-primary text-xs">🔗 URL de Redirection de Succès (Return URL)</span></label>
                    <input type="url" name="returnUrl" placeholder="https://monsite.com/merci" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" />
                    <label class="label pb-0 py-0.5"><span class="label-text-alt text-base-content/70 text-[11px]">Où rediriger le client après paiement validé.</span></label>
                </div>

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-semibold text-xs">URL d'annulation (Cancel URL - Optionnel)</span></label>
                    <input type="url" name="cancelUrl" placeholder="https://monsite.com/panier" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" />
                </div>

                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-semibold text-xs">Clé API (Laisser vide pour auto-générer)</span></label>
                    <input type="text" name="apiKey" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" placeholder="sk_hub_..." />
                </div>
                
                <div class="form-control w-full mb-3.5">
                    <label class="label py-1"><span class="label-text font-semibold text-xs">URL du Webhook de votre site (Optionnel)</span></label>
                    <input type="text" name="webhookUrl" placeholder="https://monsite.com/api/webhook" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" />
                </div>
                
                <div class="form-control w-full mb-5">
                    <label class="label py-1"><span class="label-text font-semibold text-xs">Secret Webhook (Laisser vide pour auto-générer)</span></label>
                    <input type="text" name="webhookSecret" class="input input-bordered input-sm sm:input-md w-full font-mono text-xs rounded-xl" placeholder="whsec_..." />
                </div>
                
                <div class="modal-action flex gap-2">
                    <button type="button" class="btn btn-ghost flex-1 rounded-xl" onclick="document.getElementById('add_app_modal').close()">Annuler</button>
                    <button type="submit" class="btn btn-primary flex-1 font-bold rounded-xl shadow-sm">Créer ce site</button>
                </div>
            </form>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <script>
        function openAddAppModal() {
            document.getElementById('add_app_modal').showModal();
        }

        function showToast(message, type = 'success', duration = 5000) {
            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.className = 'fixed top-5 right-5 z-[999999] flex flex-col gap-2.5 max-w-sm sm:max-w-md w-full pointer-events-none px-3 sm:px-0';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto transform transition-all duration-300 ease-out -translate-y-4 opacity-0 shadow-2xl rounded-2xl p-4 flex items-start gap-3 border text-white font-medium text-xs sm:text-sm';

            let bgClass = 'bg-emerald-600 border-emerald-400/40';
            let icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>';

            if (type === 'warning') {
                bgClass = 'bg-amber-600 border-amber-400/40';
                icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
            } else if (type === 'error') {
                bgClass = 'bg-rose-600 border-rose-400/40';
                icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>';
            }

            toast.classList.add(...bgClass.split(' '));
            toast.innerHTML = `
                ${icon}
                <div class="flex-1 leading-snug font-semibold">${message}</div>
                <button type="button" class="btn btn-ghost btn-xs btn-circle text-white/80 hover:text-white" onclick="this.parentElement.remove()">✕</button>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('-translate-y-4', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2', 'scale-95');
                setTimeout(() => {
                    if (toast.parentElement) toast.remove();
                }, 300);
            }, duration);
        }

        document.addEventListener('DOMContentLoaded', () => {
            <% if (locals.successMessage) { %>
                showToast("<%= successMessage.replace(/"/g, '\\"') %>", 'success', 5000);
            <% } %>

            <% if (locals.errorMessage) { %>
                showToast("<%= errorMessage.replace(/"/g, '\\"') %>", 'error', 5000);
            <% } %>

            if (window.location.search && (window.location.search.includes('success=') || window.location.search.includes('error='))) {
                const cleanUrl = window.location.pathname + window.location.search
                    .replace(/([&?])(success|error)=[^&]+(&|$)/g, '$1')
                    .replace(/&$/, '')
                    .replace(/\?$/, '');
                window.history.replaceState({}, document.title, cleanUrl || window.location.pathname);
            }
        });
    </script>
</body>
</html>
