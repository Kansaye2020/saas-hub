<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes Applications & Sites | SaaS Payment Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-base-200 min-h-screen">
    
    <!-- Navbar -->
    <div class="navbar bg-base-100 shadow-sm border-b border-base-300 sticky top-0 z-30">
        <div class="flex-1">
            <a href="/admin/apps" class="btn btn-ghost text-xl font-black tracking-tight text-primary flex items-center gap-2">
                <span>💳 SaaS Payment Hub</span>
            </a>
        </div>
        <div class="flex-none gap-2">
            <ul class="menu menu-horizontal px-1 font-medium items-center gap-1">
                <li><a class="active font-bold text-primary" href="/admin/apps">Mes Applications (Sites)</a></li>
                <li><a href="/admin/logout" class="text-error font-semibold hover:bg-error/10">Déconnexion</a></li>
            </ul>
        </div>
    </div>

    <div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
        
        <!-- Header -->
        <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-base-content">Mes Sites & SaaS Enregistrés</h1>
                <p class="mt-1 text-sm text-base-content/70">Sélectionnez un site pour ouvrir son tableau de bord, gérer ses transactions et configurer ses passerelles de paiement.</p>
            </div>
            <button class="btn btn-primary shadow-sm gap-2" onclick="openAddAppModal()">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Ajouter un site / SaaS
            </button>
        </div>

        <!-- Global Summary Stats Bar -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-5">
                <div class="stat-figure text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                </div>
                <div class="stat-title text-xs font-bold uppercase text-base-content/60">Sites Enregistrés</div>
                <div class="stat-value text-2xl font-black mt-0.5"><%= locals.totalAppsCount || apps.length %></div>
                <div class="stat-desc text-xs mt-0.5">Espaces SaaS actifs</div>
            </div>

            <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-5">
                <div class="stat-figure text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div class="stat-title text-xs font-bold uppercase text-base-content/60">Revenu Global (Tous Sites)</div>
                <div class="stat-value text-2xl font-black text-success mt-0.5"><%= (locals.totalGlobalRevenue || 0).toLocaleString() %> FCFA</div>
                <div class="stat-desc text-xs mt-0.5">Total cumulé encaissé</div>
            </div>

            <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-300 p-5">
                <div class="stat-figure text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                </div>
                <div class="stat-title text-xs font-bold uppercase text-base-content/60">Transactions Réussies</div>
                <div class="stat-value text-2xl font-black text-secondary mt-0.5"><%= locals.totalGlobalTransactions || 0 %></div>
                <div class="stat-desc text-xs mt-0.5">Paiements validés</div>
            </div>
        </div>

        <% if (locals.successMessage) { %>
            <div class="alert alert-success mb-6 shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span class="font-medium"><%= successMessage %></span>
                </div>
                <a href="/admin/apps" class="btn btn-ghost btn-xs">✕</a>
            </div>
        <% } %>

        <% if (locals.errorMessage) { %>
            <div class="alert alert-error mb-6 shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span class="font-medium"><%= errorMessage %></span>
                </div>
                <a href="/admin/apps" class="btn btn-ghost btn-xs">✕</a>
            </div>
        <% } %>

        <% if (apps.length === 0) { %>
            <div class="text-center py-16 bg-base-100 rounded-3xl shadow-sm border border-base-300 max-w-2xl mx-auto p-8">
                <div class="w-20 h-20 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                </div>
                <h3 class="text-2xl font-bold text-base-content">Aucun site configuré</h3>
                <p class="text-base-content/60 mt-2 mb-6">Ajoutez votre premier site pour lui attribuer ses processeurs de paiement et générer sa clé API.</p>
                <button class="btn btn-primary btn-wide shadow-md" onclick="openAddAppModal()">Ajouter mon premier site</button>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% apps.forEach(function(app) { %>
                <div class="card bg-base-100 shadow-sm hover:shadow-xl transition-all border border-base-300 flex flex-col justify-between">
                    <div class="card-body p-6">
                        
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h2 class="card-title text-2xl font-black text-base-content">
                                    <%= app.name %>
                                </h2>
                                <div class="badge badge-primary badge-outline text-xs mt-1 font-mono">ID: <%= app.id %></div>
                            </div>
                            <div class="dropdown dropdown-end">
                                <div tabindex="0" role="button" class="btn btn-ghost btn-xs btn-circle">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                                </div>
                                <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-40 text-xs border border-base-200">
                                    <li><a href="/admin/app/<%= app.id %>?tab=settings">Modifier</a></li>
                                    <li>
                                        <form method="POST" action="/admin/apps/delete" onsubmit="return confirm('Supprimer ce site ?')" class="m-0 p-0">
                                            <input type="hidden" name="appId" value="<%= app.id %>">
                                            <button type="submit" class="text-error font-bold w-full text-left px-3 py-1.5">Supprimer</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Métriques du site -->
                        <div class="grid grid-cols-2 gap-3 mb-4">
                            <div class="bg-base-200 p-3 rounded-xl border border-base-300">
                                <div class="text-[10px] uppercase font-bold text-base-content/60">Revenu de ce site</div>
                                <div class="text-base font-black text-primary mt-0.5"><%= (app.totalRevenue || 0).toLocaleString() %> FCFA</div>
                            </div>
                            <div class="bg-base-200 p-3 rounded-xl border border-base-300">
                                <div class="text-[10px] uppercase font-bold text-base-content/60">Transactions</div>
                                <div class="text-base font-black text-secondary mt-0.5"><%= app.transactionCount || 0 %></div>
                            </div>
                        </div>

                        <!-- Processeurs Actifs pour ce site -->
                        <div class="mb-4">
                            <div class="text-[11px] font-bold text-base-content/60 uppercase mb-1.5 flex items-center justify-between">
                                <span>Passerelles actives</span>
                                <span class="badge badge-xs <%= app.activeProvidersCount > 0 ? 'badge-success text-white' : 'badge-ghost' %> font-mono font-bold"><%= app.activeProvidersCount %> actif(s)</span>
                            </div>
                            <div class="flex flex-wrap gap-1">
                                <% if (app.activeProviders && app.activeProviders.length > 0) { %>
                                    <% app.activeProviders.forEach(function(prov) { %>
                                        <span class="badge badge-sm badge-neutral capitalize font-semibold"><%= prov %></span>
                                    <% }); %>
                                <% } else { %>
                                    <span class="text-xs text-base-content/50 italic">Aucune passerelle configurée</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Bouton d'accès au dashboard dédié -->
                        <div class="card-actions mt-4 pt-4 border-t border-base-200">
                            <a href="/admin/app/<%= app.id %>" class="btn btn-primary btn-block font-bold shadow-sm gap-2">
                                <span>📊 Ouvrir le Dashboard de ce site</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

    </div>

    <!-- Modal Ajouter un Site -->
    <dialog id="add_app_modal" class="modal">
        <div class="modal-box max-w-xl">
            <h3 class="font-extrabold text-xl mb-4 text-base-content">Ajouter un nouveau site / SaaS</h3>
            <form method="POST" action="/admin/apps">
                <div class="form-control w-full mb-4">
                    <label class="label"><span class="label-text font-bold">Identifiant technique du site (ex: "verifsms", "monshop")</span></label>
                    <input type="text" name="id" class="input input-bordered w-full font-mono text-sm" placeholder="ex: mon-saas-1" required />
                    <label class="label py-0.5"><span class="label-text-alt text-base-content/60">Sera utilisé comme appId dans vos requêtes API et webhooks.</span></label>
                </div>
                <div class="form-control w-full mb-4">
                    <label class="label"><span class="label-text font-bold">Nom Public du Site (affiché au client au checkout)</span></label>
                    <input type="text" name="name" class="input input-bordered w-full font-semibold" placeholder="ex: Ma Boutique Officielle" required />
                </div>

                <div class="form-control w-full mb-4 bg-primary/5 p-3 rounded-xl border border-primary/20">
                    <label class="label pt-0"><span class="label-text font-bold text-primary">🔗 URL de Redirection de Succès (Return URL)</span></label>
                    <input type="url" name="returnUrl" placeholder="https://monsite.com/merci" class="input input-bordered w-full font-mono text-sm" />
                    <label class="label pb-0"><span class="label-text-alt text-base-content/70">Où rediriger le client après que son paiement a été validé.</span></label>
                </div>

                <div class="form-control w-full mb-4">
                    <label class="label"><span class="label-text font-semibold">URL d'annulation (Cancel URL - Optionnel)</span></label>
                    <input type="url" name="cancelUrl" placeholder="https://monsite.com/panier" class="input input-bordered w-full font-mono text-sm" />
                </div>

                <div class="form-control w-full mb-4">
                    <label class="label"><span class="label-text font-semibold">Clé API (Laisser vide pour auto-générer)</span></label>
                    <input type="text" name="apiKey" class="input input-bordered w-full font-mono text-sm" placeholder="sk_hub_..." />
                </div>
                <div class="form-control w-full mb-4">
                    <label class="label"><span class="label-text font-semibold">URL du Webhook de votre site (Optionnel)</span></label>
                    <input type="text" name="webhookUrl" placeholder="https://monsite.com/api/webhook" class="input input-bordered w-full font-mono text-sm" />
                </div>
                <div class="form-control w-full mb-6">
                    <label class="label"><span class="label-text font-semibold">Secret Webhook (Laisser vide pour auto-générer)</span></label>
                    <input type="text" name="webhookSecret" class="input input-bordered w-full font-mono text-sm" placeholder="whsec_..." />
                </div>
                <div class="modal-action">
                    <button type="button" class="btn" onclick="document.getElementById('add_app_modal').close()">Annuler</button>
                    <button type="submit" class="btn btn-primary font-bold px-6">Créer ce site</button>
                </div>
            </form>
        </div>
    </dialog>

    <script>
        function openAddAppModal() {
            document.getElementById('add_app_modal').showModal();
        }
    </script>
</body>
</html>
