<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Processeurs | SaaS Payment Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.10.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-base-200 min-h-screen">
    
    <div class="navbar bg-base-100 shadow-sm border-b border-base-300">
        <div class="flex-1">
            <a class="btn btn-ghost text-xl">SaaS Hub Admin</a>
        </div>
        <div class="flex-none gap-2">
            <ul class="menu menu-horizontal px-1 font-medium">
                <li><a href="/admin">Dashboard</a></li>
                <li><a class="active" href="/admin/settings">Processeurs</a></li>
            </ul>
        </div>
    </div>

    <div class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
        
        <div class="mb-8 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold">Processeurs de Paiement</h1>
                <p class="mt-2 text-base-content/70">Configurez les clés API de vos différents processeurs. Ces clés écraseront celles définies dans le fichier .env.</p>
            </div>
        </div>

        <% if (locals.successMessage) { %>
            <div role="alert" class="alert alert-success shadow-lg mb-8">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span><%= successMessage %></span>
            </div>
        <% } %>
        
        <div class="space-y-6">
            <!-- Whop -->
            <div class="card bg-base-100 shadow-xl border border-base-200">
                <div class="card-body">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h2 class="card-title">Whop</h2>
                            <p class="text-sm text-base-content/60 mt-1">Paiements par carte bancaire internationaux.</p>
                        </div>
                        <div class="badge <%= configs['whop']?.isActive ? 'badge-success' : 'badge-ghost' %> gap-2">
                            <%= configs['whop']?.isActive ? 'Actif' : 'Inactif' %>
                        </div>
                    </div>

                    <form action="/admin/settings/provider" method="POST">
                        <input type="hidden" name="providerId" value="whop">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <label class="form-control w-full">
                                <div class="label"><span class="label-text font-semibold">Company ID</span></div>
                                <input type="text" name="publicKey" value="<%= configs['whop']?.publicKey || '' %>" class="input input-bordered w-full" />
                            </label>
                            
                            <label class="form-control w-full">
                                <div class="label"><span class="label-text font-semibold">API Key</span></div>
                                <input type="password" name="secretKey" value="<%= configs['whop']?.secretKey || '' %>" class="input input-bordered w-full" />
                            </label>

                            <div class="form-control md:col-span-2">
                                <label class="label cursor-pointer justify-start gap-4">
                                    <input type="checkbox" name="isActive" value="1" <%= configs['whop']?.isActive ? 'checked' : '' %> class="toggle toggle-primary" />
                                    <span class="label-text">Activer ce processeur</span>
                                </label>
                            </div>
                        </div>
                        <div class="card-actions justify-end mt-4">
                            <button type="submit" class="btn btn-primary">Sauvegarder Whop</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Lomopay -->
            <div class="card bg-base-100 shadow-xl border border-base-200">
                <div class="card-body">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h2 class="card-title">Lomopay</h2>
                            <p class="text-sm text-base-content/60 mt-1">Mobile Money (Wave, Orange, MTN).</p>
                        </div>
                        <div class="badge <%= configs['lomopay']?.isActive ? 'badge-success' : 'badge-ghost' %> gap-2">
                            <%= configs['lomopay']?.isActive ? 'Actif' : 'Inactif' %>
                        </div>
                    </div>

                    <form action="/admin/settings/provider" method="POST">
                        <input type="hidden" name="providerId" value="lomopay">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <label class="form-control w-full">
                                <div class="label"><span class="label-text font-semibold">Clé Publique</span></div>
                                <input type="text" name="publicKey" value="<%= configs['lomopay']?.publicKey || '' %>" class="input input-bordered w-full" />
                            </label>
                            
                            <label class="form-control w-full">
                                <div class="label"><span class="label-text font-semibold">Clé Secrète</span></div>
                                <input type="password" name="secretKey" value="<%= configs['lomopay']?.secretKey || '' %>" class="input input-bordered w-full" />
                            </label>

                            <div class="form-control md:col-span-2">
                                <label class="label cursor-pointer justify-start gap-4">
                                    <input type="checkbox" name="isActive" value="1" <%= configs['lomopay']?.isActive ? 'checked' : '' %> class="toggle toggle-primary" />
                                    <span class="label-text">Activer ce processeur</span>
                                </label>
                            </div>
                        </div>
                        <div class="card-actions justify-end mt-4">
                            <button type="submit" class="btn btn-primary">Sauvegarder Lomopay</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- iKeepay -->
            <div class="card bg-base-100 shadow-xl border-2 border-primary/20">
                <div class="card-body">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h2 class="card-title">
                                iKeepay
                                <div class="badge badge-secondary">Nouveau</div>
                            </h2>
                            <p class="text-sm text-base-content/60 mt-1">Paiements Mobile Money et cartes en Afrique.</p>
                        </div>
                        <div class="badge <%= configs['ikeepay']?.isActive ? 'badge-success' : 'badge-ghost' %> gap-2">
                            <%= configs['ikeepay']?.isActive ? 'Actif' : 'Inactif' %>
                        </div>
                    </div>

                    <form action="/admin/settings/provider" method="POST">
                        <input type="hidden" name="providerId" value="ikeepay">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <label class="form-control w-full">
                                <div class="label"><span class="label-text font-semibold">Public Key (ou API Key)</span></div>
                                <input type="text" name="publicKey" value="<%= configs['ikeepay']?.publicKey || '' %>" class="input input-bordered w-full" />
                            </label>
                            
                            <label class="form-control w-full">
                                <div class="label"><span class="label-text font-semibold">Secret Key (ou Merchant ID)</span></div>
                                <input type="password" name="secretKey" value="<%= configs['ikeepay']?.secretKey || '' %>" class="input input-bordered w-full" />
                            </label>
                            
                            <label class="form-control w-full md:col-span-2">
                                <div class="label"><span class="label-text font-semibold">Configuration supplémentaire (Optionnel, JSON)</span></div>
                                <input type="text" name="extraConfig" value="<%= configs['ikeepay']?.extraConfig || '' %>" placeholder='{"webhookSecret": "..."}' class="input input-bordered w-full font-mono text-sm" />
                            </label>

                            <div class="form-control md:col-span-2">
                                <label class="label cursor-pointer justify-start gap-4">
                                    <input type="checkbox" name="isActive" value="1" <%= configs['ikeepay']?.isActive ? 'checked' : '' %> class="toggle toggle-primary" />
                                    <span class="label-text">Activer ce processeur</span>
                                </label>
                            </div>
                        </div>
                        <div class="card-actions justify-end mt-4">
                            <button type="submit" class="btn btn-primary">Sauvegarder iKeepay</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
