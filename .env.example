# ==============================================================================
# CONFIGURATION SERVEUR SAAS PAYMENT HUB
# ==============================================================================
PORT=4000
NODE_ENV=production
# URL publique où ce hub de paiement est hébergé (ex: https://pay.mondomaine.com)
HUB_BASE_URL=http://localhost:4000

# ==============================================================================
# APPLICATIONS CLIENTES (VOS SAAS CONNECTÉS)
# Format JSON : Liste des SaaS autorisés à appeler ce Hub
# - id: Identifiant unique du SaaS (ex: "verifsms", "saas2")
# - name: Nom lisible
# - apiKey: Clé secrète que le SaaS doit envoyer dans le header 'X-Hub-Api-Key'
# - webhookUrl: URL de votre SaaS où le Hub transmet les notifications de paiement validé
# - webhookSecret: Clé secrète pour signer le webhook envoyé au SaaS (HMAC-SHA256)
# ==============================================================================
CLIENT_APPS='[
  {
    "id": "verifsms",
    "name": "VerifSMS",
    "apiKey": "vfs_live_sec_7a8b9c1d2e3f4g5h6j",
    "webhookUrl": "https://verifsms.relyx.xyz/api/webhooks/hub-payment",
    "webhookSecret": "whsec_vfs_998877665544332211"
  },
  {
    "id": "saas2",
    "name": "MonDeuxiemeSaas",
    "apiKey": "saas2_live_sec_8976543210fedcba",
    "webhookUrl": "https://mondeuxiemesaas.com/api/webhooks/payment",
    "webhookSecret": "whsec_saas2_1234567890abcdef"
  }
]'

# ==============================================================================
# 1. PASSERELLE LOMOPAY (Mobile Money: Wave, Orange Money, MTN, Moov, Djamo)
# ==============================================================================
LOMOPAY_PUBLIC_KEY=
LOMOPAY_SECRET_KEY=
LOMOPAY_API_URL=https://lomopay.net/api/v1/payments.php

# ==============================================================================
# 2. PASSERELLE WHOP (Cartes Bancaires Internationales, Apple Pay, Google Pay)
# ==============================================================================
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_SANDBOX=false

# ==============================================================================
# 3. PASSERELLE STRIPE (Paiement direct par Carte Bancaire - Optionnel)
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# 4. PASSERELLE CHARIOW (Mobile Money alternatif - Optionnel)
# ==============================================================================
CHARIOW_SECRET_KEY=
CHARIOW_PUBLIC_KEY=
