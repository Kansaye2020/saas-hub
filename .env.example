# ==============================================================================
# CONFIGURATION SERVEUR SAAS PAYMENT HUB (Production / Koyeb / Neon)
# ==============================================================================
PORT=4000
NODE_ENV=production

# URL publique de votre Hub déployé (ex: https://saas-hub.koyeb.app ou https://pay.votredomaine.com)
HUB_BASE_URL=https://saas-payment-hub.koyeb.app

# URL optionnelle pour le sous-domaine de paiement (ex: https://checkout.votredomaine.com)
# Laissez vide si vous utilisez le domaine par défaut de Koyeb
CHECKOUT_BASE_URL=

# ==============================================================================
# BASE DE DONNÉES POSTGRESQL (NEON.TECH)
# Renseignez ici l'URL de connexion fournie par votre dashboard Neon.tech
# ==============================================================================
DATABASE_URL=postgres://neondb_owner:password@ep-nom-de-base.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# ACCÈS MASTER ADMINISTRATEUR (POUR LE DASHBOARD)
# Modifiez ces identifiants pour sécuriser l'accès en ligne
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production_123456

# ==============================================================================
# REMARQUE : CONFIGURATION DES PASSERELLES ET DES SITES
# Vous n'avez pas besoin de remplir les clés ici !
# Vous pouvez configurer chaque site (VerifSMS, Boutique, etc.) et ses clés
# propres (LomoPay, Whop, Stripe, Chariow, iKeepay) directement depuis
# l'interface d'administration : /admin
# ==============================================================================
