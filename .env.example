# ==============================================================================
# SAAS PAYMENT HUB - VARIABLES D'ENVIRONNEMENT (.env)
# ==============================================================================

# Port d'écoute du serveur (par défaut: 4000)
PORT=4000

# Environnement d'exécution : "development" ou "production"
NODE_ENV=development

# ------------------------------------------------------------------------------
# URLS DU HUB DE PAIEMENT
# ------------------------------------------------------------------------------
# URL publique accessible de votre Hub
# En local : http://localhost:4000
# En production : https://saas-hub.votredomaine.com (ou https://votre-app.koyeb.app / https://votre-app.onrender.com)
HUB_BASE_URL=http://localhost:4000

# URL optionnelle dédiée au Checkout sous-domaine (ex: https://checkout.votredomaine.com)
# Si laissée vide, le Hub utilisera automatiquement HUB_BASE_URL ou le sous-domaine 'checkout.'
CHECKOUT_BASE_URL=

# ------------------------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL ou SQLite)
# ------------------------------------------------------------------------------
# PostgreSQL (Production recommandée : Neon.tech, Supabase, Render, Railway)
# Laissez cette ligne commentée ou vide pour utiliser automatiquement SQLite local (aucun serveur BDD requis en local !)
# DATABASE_URL=postgres://user:password@ep-nom-de-base.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Chemin du fichier SQLite local (par défaut: ./data/database.sqlite si DATABASE_URL est vide)
# DB_PATH=./data/database.sqlite

# ------------------------------------------------------------------------------
# ACCÈS MASTER ADMINISTRATEUR (Dashboard /admin)
# ------------------------------------------------------------------------------
# Identifiants pour vous connecter au dashboard d'administration global
# (Vous pouvez également vous connecter directement avec la clé API sk_hub_... d'un site)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secret utilisé pour signer les sessions administrateur (mettez une chaîne longue et aléatoire en production)
ADMIN_JWT_SECRET=change_this_to_a_super_long_random_secret_string_in_production_123456

# ------------------------------------------------------------------------------
# SÉCURITÉ & CHIFFREMENT (Optionnel)
# ------------------------------------------------------------------------------
# Clé secrète de chiffrement AES-256-GCM pour protéger les clés API des processeurs en BDD.
# Si non définie, une clé dérivée d'ADMIN_JWT_SECRET est utilisée automatiquement.
# ENCRYPTION_KEY=votre_cle_de_chiffrement_secrete_tres_robuste_32_caracteres_min

# ==============================================================================
# REMARQUE IMPORTANTE : CONFIGURATION DES SITES ET DES PASSERELLES
# ==============================================================================
# Vous n'avez PAS besoin de renseigner les clés API de vos passerelles
# (SasPay, LomoPay, iKeePay, Whop, Stripe, DepiPay, Chariow) ici !
# Chaque site SaaS (ex: VerifSMS, Boutique, MonApp) configure ses propres passerelles
# et clés API de manière isolée directement depuis l'interface web :
# http://localhost:4000/admin (Onglet Processeurs de chaque site).
